{% comment %}
  KOCKKROCH (KOCX KROCH) — Pure Logo Intro Animation
  Fearless from Origin • Built to Survive
  Archival Minimalist Loading Experience: Seamless Dissolve, Unified Monolithic Strokes
{% endcomment %}

{%- liquid
  assign enable_intro = settings.enable_intro_animation
  if enable_intro == nil
    assign enable_intro = true
  endif

  assign intro_frequency = settings.intro_frequency | default: 'always'
-%}

{%- if enable_intro -%}
  <style id="kockkroch-intro-styles">
    :root {
      /* Seamlessly blend with store background & typography palette */
      --k-intro-bg: {{ settings.color_palette.background | default: '#F4F2ED' }};
      --k-intro-stroke: {{ settings.color_palette.foreground | default: '#101012' }};
      --k-intro-ambient: rgba(16, 16, 18, 0.02);
    }

    body.kockkroch-intro-active {
      overflow: hidden !important;
      height: 100vh !important;
      touch-action: none !important;
    }

    /* Fullscreen Intro Dissolve Canvas */
    .kockkroch-intro {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: 9999999;
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: var(--k-intro-bg);
      overflow: hidden;
      user-select: none;
      font-family: inherit;
      opacity: 1;
      filter: blur(0px);
      transform: scale(1);
      transition: opacity 0.85s cubic-bezier(0.25, 1, 0.5, 1),
                  filter 0.85s cubic-bezier(0.25, 1, 0.5, 1),
                  transform 0.85s cubic-bezier(0.25, 1, 0.5, 1);
      will-change: opacity, filter, transform;
    }

    /* Soft ambient lighting that dissolves seamlessly to the edges */
    .kockkroch-intro__backdrop {
      position: absolute;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
      background: radial-gradient(circle at 50% 50%, var(--k-intro-ambient) 0%, transparent 70%);
    }

    /* Center Stage Container */
    .kockkroch-intro__stage {
      position: relative;
      z-index: 5;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 24px;
      opacity: 1;
      transform: scale(1);
      filter: blur(0px);
      transition: opacity 0.7s cubic-bezier(0.25, 1, 0.5, 1),
                  transform 0.85s cubic-bezier(0.16, 1, 0.3, 1),
                  filter 0.7s ease;
      will-change: opacity, transform, filter;
    }

    /* Emblem Wrap */
    .kockkroch-intro__emblem-wrap {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .kockkroch-intro__emblem {
      width: 160px;
      height: 200px;
      display: block;
      transform-origin: center center;
      animation: kIntroEmblemScale 1.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Unified, Harmonious Vector Stroke Drawing — All strokes share identical color & weight */
    .kockkroch-intro__emblem .k-stroke {
      stroke: var(--k-intro-stroke);
      stroke-width: 0.65;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-dasharray: 200;
      stroke-dashoffset: 200;
      opacity: 0.9;
      animation: kIntroDrawStroke 1.2s cubic-bezier(0.65, 0, 0.35, 1) forwards;
    }

    .kockkroch-intro__emblem .k-s1  { animation-delay: 0.00s; }
    .kockkroch-intro__emblem .k-s2  { animation-delay: 0.06s; }
    .kockkroch-intro__emblem .k-s3  { animation-delay: 0.12s; }
    .kockkroch-intro__emblem .k-s4  { animation-delay: 0.04s; }
    .kockkroch-intro__emblem .k-s5  { animation-delay: 0.16s; }
    .kockkroch-intro__emblem .k-s6  { animation-delay: 0.20s; }
    .kockkroch-intro__emblem .k-s7  { animation-delay: 0.24s; }
    .kockkroch-intro__emblem .k-s8  { animation-delay: 0.28s; }
    .kockkroch-intro__emblem .k-s9  { animation-delay: 0.10s; }
    .kockkroch-intro__emblem .k-s10 { animation-delay: 0.30s; }
    .kockkroch-intro__emblem .k-s11 { animation-delay: 0.34s; }
    .kockkroch-intro__emblem .k-s12 { animation-delay: 0.38s; }
    .kockkroch-intro__emblem .k-s13 { animation-delay: 0.42s; }
    .kockkroch-intro__emblem .k-s14 { animation-delay: 0.46s; }
    .kockkroch-intro__emblem .k-s15 { animation-delay: 0.50s; }

    /* Shard facet shares the EXACT SAME stroke color as the entire emblem (no contrasting colored borders) */
    .kockkroch-intro__emblem .k-shard {
      stroke: var(--k-intro-stroke);
      stroke-width: 0.65;
      stroke-linecap: round;
      stroke-linejoin: round;
      fill: var(--k-intro-stroke);
      opacity: 0;
      transform-origin: 38px 51px;
      animation: kIntroShardDissolve 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.5s forwards;
    }

    /* Dissolve exit state — melts smoothly into the storefront with zero contrasting borders or split seams */
    .kockkroch-intro--exiting {
      pointer-events: none !important;
      opacity: 0 !important;
      filter: blur(8px) !important;
      transform: scale(1.02) !important;
      transition: opacity 0.8s cubic-bezier(0.25, 1, 0.5, 1),
                  filter 0.8s cubic-bezier(0.25, 1, 0.5, 1),
                  transform 0.8s cubic-bezier(0.25, 1, 0.5, 1) !important;
    }

    .kockkroch-intro--exiting .kockkroch-intro__stage {
      opacity: 0 !important;
      transform: scale(0.96) !important;
      filter: blur(6px) !important;
      transition: opacity 0.65s cubic-bezier(0.25, 1, 0.5, 1),
                  transform 0.8s cubic-bezier(0.25, 1, 0.5, 1),
                  filter 0.65s cubic-bezier(0.25, 1, 0.5, 1) !important;
    }

    .kockkroch-intro--hidden {
      display: none !important;
    }

    @keyframes kIntroEmblemScale {
      0% { transform: scale(0.95); opacity: 0.7; }
      100% { transform: scale(1); opacity: 1; }
    }

    @keyframes kIntroDrawStroke {
      to { stroke-dashoffset: 0; }
    }

    @keyframes kIntroShardDissolve {
      0% {
        opacity: 0;
        transform: scale(0.85);
      }
      100% {
        opacity: 0.9;
        transform: scale(1);
      }
    }

    @media (max-width: 640px) {
      .kockkroch-intro__emblem {
        width: 130px;
        height: 160px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .kockkroch-intro__emblem .k-stroke,
      .kockkroch-intro__emblem .k-shard {
        animation: none !important;
        stroke-dashoffset: 0 !important;
        opacity: 0.9 !important;
        transform: none !important;
      }
      .kockkroch-intro {
        transition: opacity 0.4s ease !important;
        filter: none !important;
      }
    }
  </style>

  <div
    id="kockkroch-intro"
    class="kockkroch-intro"
    data-frequency="{{ intro_frequency }}"
    aria-hidden="false"
    role="dialog"
    aria-label="KOCKKROCH"
  >
    <!-- Soft Dissolve Atmosphere (No contrasting grid lines or scanline borders) -->
    <div class="kockkroch-intro__backdrop"></div>

    <!-- Center Stage Container (Pure Emblem Only) -->
    <div class="kockkroch-intro__stage">
      <div class="kockkroch-intro__emblem-wrap">
        <svg
          class="kockkroch-intro__emblem"
          viewBox="0 0 63.80 78.70"
          xmlns="http://www.w3.org/2000/svg"
        >
          <!-- Fine Unified Wireframe Facet Paths -->
          <path class="k-stroke k-s1" d="M 41.53 22.11 L 36.08 13.65 L 31.23 10.26 L 27.25 13.52 L 22.24 22.35 L 41.53 22.11" fill="none" />
          <path class="k-stroke k-s2" d="M 19.29 42.31 L 22.15 23.82 L 41.75 23.59 L 45.28 42.16 L 45.39 50.43 L 36.21 30.32 L 26.88 49.74 L 41.50 63.08 L 39.25 69.79 L 33.73 74.57 L 26.82 69.97 L 22.36 61.04 L 19.29 42.31" fill="none" />
          <path class="k-stroke k-s3" d="M 54.00 72.64 L 36.06 34.54 L 28.81 49.45 L 54.00 72.64" fill="none" />
          <path class="k-stroke k-s4" d="M 18.62 33.19 L 20.57 25.22 L 11.64 22.19 L 4.25 49.24 L 4.00 74.70 L 8.20 53.28 L 15.17 40.55 L 12.35 29.00 L 18.62 33.19" fill="none" />
          <path class="k-stroke k-s5" d="M 40.95 4.00 L 54.18 14.99 L 41.80 7.23 L 36.47 12.38 L 32.64 9.65 L 40.95 4.00" fill="none" />
          <path class="k-stroke k-s6" d="M 20.87 4.02 L 7.63 15.00 L 20.02 7.25 L 26.25 12.34 L 29.45 9.70 L 20.87 4.02" fill="none" />
          <path class="k-stroke k-s7" d="M 26.25 12.35 L 20.61 5.55 L 29.45 9.70" fill="none" />
          <path class="k-stroke k-s8" d="M 36.47 12.38 L 41.49 5.36 L 32.64 9.65" fill="none" />
          <path class="k-stroke k-s9" d="M 27.73 13.55 L 35.33 13.45 L 22.66 22.19 L 41.08 21.95 L 27.73 13.55" fill="none" />
          <path class="k-stroke k-s10" d="M 18.62 33.19 L 11.82 22.69 L 12.35 29.00 L 8.37 34.17 L 15.12 40.35 L 4.25 49.24 L 8.20 53.28 L 5.05 57.78 L 4.01 73.99" fill="none" />
          <path class="k-stroke k-s11" d="M 45.18 32.74 L 43.22 24.78 L 52.16 21.74 L 59.55 48.80 L 59.80 74.25 L 55.60 52.83 L 48.63 40.10 L 51.29 28.59 L 45.18 32.74" fill="none" />
          <path class="k-stroke k-s12" d="M 59.68 73.63 L 58.52 57.45 L 55.60 52.83 L 59.37 48.15 L 49.07 39.85 L 55.21 32.93 L 51.45 28.55 L 52.09 22.41 L 45.18 32.74" fill="none" />
          <path class="k-stroke k-s13" d="M 41.59 23.79 L 20.25 41.53 L 27.87 29.41 L 22.90 24.22 L 41.40 30.39 L 45.18 41.65 L 42.17 43.22" fill="none" />
          <path class="k-stroke k-s14" d="M 22.36 61.04 L 40.38 66.43" fill="none" />
          <path class="k-stroke k-s15" d="M 19.36 42.76 L 34.78 69.07 L 26.88 49.74" fill="none" />
          
          <!-- Unified Shard Facet (Matches identical stroke color & width, no contrasting red border) -->
          <path class="k-shard" d="M 32.00 48.96 L 51.95 69.96 L 38.88 51.18 L 36.14 37.94 L 32.00 48.96 Z" />
        </svg>
      </div>
    </div>
  </div>

  <script id="kockkroch-intro-script">
    (function () {
      'use strict';
      const STORAGE_KEY = 'kockkroch_intro_seen';
      const INTRO_DURATION_MS = 1700;

      function initKockkrochIntro() {
        const introEl = document.getElementById('kockkroch-intro');
        if (!introEl) return;

        // Skip in Shopify Theme Customizer editor view so merchant can design freely
        if (window.Shopify && window.Shopify.designMode) {
          introEl.classList.add('kockkroch-intro--hidden');
          return;
        }

        const frequency = introEl.getAttribute('data-frequency') || 'always';
        if (frequency === 'once' && sessionStorage.getItem(STORAGE_KEY)) {
          introEl.classList.add('kockkroch-intro--hidden');
          return;
        }

        // Dynamically harmonize background color to body so there is zero contrast or border
        try {
          const bodyBg = window.getComputedStyle(document.body).backgroundColor;
          if (bodyBg && bodyBg !== 'transparent' && bodyBg !== 'rgba(0, 0, 0, 0)') {
            introEl.style.backgroundColor = bodyBg;
          }
        } catch (e) {}

        document.body.classList.add('kockkroch-intro-active');
        let isExited = false;

        function completeIntro() {
          if (isExited) return;
          isExited = true;

          try {
            sessionStorage.setItem(STORAGE_KEY, 'true');
          } catch (e) {}

          // Smooth atmospheric dissolve
          introEl.classList.add('kockkroch-intro--exiting');
          document.body.classList.remove('kockkroch-intro-active');

          document.dispatchEvent(
            new CustomEvent('kockkroch:intro:complete', { bubbles: true })
          );

          setTimeout(function () {
            introEl.classList.add('kockkroch-intro--hidden');
          }, 850);
        }

        setTimeout(completeIntro, INTRO_DURATION_MS);

        // Optional keyboard ESC shortcut
        function onKeyDown(e) {
          if (e.key === 'Escape' || e.keyCode === 27) {
            completeIntro();
            window.removeEventListener('keydown', onKeyDown);
          }
        }
        window.addEventListener('keydown', onKeyDown);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initKockkrochIntro);
      } else {
        initKockkrochIntro();
      }
    })();
  </script>
{%- endif -%}
