{% comment %}
  KOCKKROCH (KOCX KROCH) — Pure Logo Intro Animation
  Fearless from Origin • Built to Survive
{% endcomment %}

{%- liquid
  assign enable_intro = settings.enable_intro_animation
  if enable_intro == nil
    assign enable_intro = true
  endif

  assign intro_frequency = settings.intro_frequency | default: 'always'
-%}

{%- if enable_intro -%}
  <style id="kockkroch-intro-styles">
    :root {
      --k-intro-bg: #050507;
      --k-intro-red: #E3000F;
      --k-intro-red-glow: rgba(227, 0, 15, 0.75);
      --k-intro-white: #FFFFFF;
      --k-intro-silver: #A1A1AA;
      --k-intro-border: rgba(255, 255, 255, 0.12);
    }

    body.kockkroch-intro-active {
      overflow: hidden !important;
      height: 100vh !important;
      touch-action: none !important;
    }

    .kockkroch-intro {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: 9999999;
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: var(--k-intro-bg);
      overflow: hidden;
      user-select: none;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      opacity: 1;
      transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .kockkroch-intro__backdrop {
      position: absolute;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
    }

    .kockkroch-intro__grid {
      position: absolute;
      inset: -100px;
      background-image: 
        linear-gradient(to right, rgba(255, 255, 255, 0.025) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
      background-size: 48px 48px;
      mask-image: radial-gradient(circle at center, black 40%, transparent 80%);
      -webkit-mask-image: radial-gradient(circle at center, black 40%, transparent 80%);
      animation: kIntroGridDrift 20s linear infinite;
    }

    .kockkroch-intro__scanline {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 3px;
      background: linear-gradient(90deg, transparent, rgba(227, 0, 15, 0.5), transparent);
      opacity: 0.6;
      animation: kIntroScanline 3s ease-in-out infinite;
    }

    .kockkroch-intro__noise {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 50% 50%, rgba(227, 0, 15, 0.07) 0%, transparent 70%);
      pointer-events: none;
    }

    .kockkroch-intro__skip {
      position: absolute;
      top: 24px;
      right: 28px;
      z-index: 10;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 14px;
      background: rgba(18, 18, 22, 0.85);
      border: 1px solid var(--k-intro-border);
      color: var(--k-intro-silver);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      border-radius: 4px;
      cursor: pointer;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      transition: all 0.2s ease;
      opacity: 0;
      animation: kIntroFadeIn 0.5s ease 0.4s forwards;
    }

    .kockkroch-intro__skip:hover {
      color: var(--k-intro-white);
      border-color: var(--k-intro-red);
      background: rgba(227, 0, 15, 0.15);
      box-shadow: 0 0 15px rgba(227, 0, 15, 0.3);
    }

    .kockkroch-intro__skip kbd {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 3px;
      padding: 2px 5px;
      font-size: 9px;
      font-family: inherit;
      color: var(--k-intro-white);
    }

    .kockkroch-intro__stage {
      position: relative;
      z-index: 5;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 20px;
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s ease;
    }

    .kockkroch-intro__emblem-wrap {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .kockkroch-intro__emblem {
      width: 170px;
      height: 210px;
      display: block;
      filter: drop-shadow(0 0 30px rgba(0, 0, 0, 0.95));
      transform-origin: center center;
      animation: kIntroEmblemScale 1.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .kockkroch-intro__emblem .k-stroke {
      stroke-dasharray: 240;
      stroke-dashoffset: 240;
      animation: kIntroDrawStroke 1.2s cubic-bezier(0.65, 0, 0.35, 1) forwards;
    }

    .kockkroch-intro__emblem .k-s1  { animation-delay: 0.00s; }
    .kockkroch-intro__emblem .k-s2  { animation-delay: 0.08s; }
    .kockkroch-intro__emblem .k-s3  { animation-delay: 0.16s; }
    .kockkroch-intro__emblem .k-s4  { animation-delay: 0.05s; }
    .kockkroch-intro__emblem .k-s5  { animation-delay: 0.20s; }
    .kockkroch-intro__emblem .k-s6  { animation-delay: 0.24s; }
    .kockkroch-intro__emblem .k-s7  { animation-delay: 0.28s; }
    .kockkroch-intro__emblem .k-s8  { animation-delay: 0.32s; }
    .kockkroch-intro__emblem .k-s9  { animation-delay: 0.12s; }
    .kockkroch-intro__emblem .k-s10 { animation-delay: 0.36s; }
    .kockkroch-intro__emblem .k-s11 { animation-delay: 0.40s; }
    .kockkroch-intro__emblem .k-s12 { animation-delay: 0.44s; }
    .kockkroch-intro__emblem .k-s13 { animation-delay: 0.48s; }
    .kockkroch-intro__emblem .k-s14 { animation-delay: 0.52s; }
    .kockkroch-intro__emblem .k-s15 { animation-delay: 0.56s; }

    .kockkroch-intro__emblem .k-shard {
      opacity: 0;
      transform-origin: 38px 51px;
      transform: scale(0.6);
      animation: kIntroShardIgnite 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.65s forwards;
    }

    .kockkroch-intro__shutter-top,
    .kockkroch-intro__shutter-bottom {
      position: absolute;
      left: 0;
      width: 100%;
      height: 50%;
      background: var(--k-intro-bg);
      z-index: 2;
      transition: transform 0.75s cubic-bezier(0.77, 0, 0.175, 1);
      pointer-events: none;
    }

    .kockkroch-intro__shutter-top {
      top: 0;
      transform: translateY(0%);
    }

    .kockkroch-intro__shutter-bottom {
      bottom: 0;
      transform: translateY(0%);
    }

    .kockkroch-intro--exiting .kockkroch-intro__stage {
      opacity: 0;
      transform: scale(1.1);
      transition: opacity 0.35s ease, transform 0.5s ease;
    }

    .kockkroch-intro--exiting .kockkroch-intro__shutter-top {
      transform: translateY(-100%);
    }

    .kockkroch-intro--exiting .kockkroch-intro__shutter-bottom {
      transform: translateY(100%);
    }

    .kockkroch-intro--exiting {
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.75s ease 0.2s;
    }

    .kockkroch-intro--hidden {
      display: none !important;
    }

    @keyframes kIntroEmblemScale {
      0% { transform: scale(0.92); }
      100% { transform: scale(1); }
    }

    @keyframes kIntroDrawStroke {
      to { stroke-dashoffset: 0; }
    }

    @keyframes kIntroShardIgnite {
      0% {
        opacity: 0;
        transform: scale(0.5);
        filter: drop-shadow(0 0 0px var(--k-intro-red));
      }
      50% {
        opacity: 1;
        transform: scale(1.18);
        filter: drop-shadow(0 0 25px var(--k-intro-red)) drop-shadow(0 0 60px var(--k-intro-red));
      }
      100% {
        opacity: 1;
        transform: scale(1);
        filter: drop-shadow(0 0 16px var(--k-intro-red));
      }
    }

    @keyframes kIntroFadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes kIntroGridDrift {
      0% { transform: translateY(0); }
      100% { transform: translateY(48px); }
    }

    @keyframes kIntroScanline {
      0% { top: 0%; opacity: 0; }
      15% { opacity: 0.7; }
      85% { opacity: 0.7; }
      100% { top: 100%; opacity: 0; }
    }

    @media (max-width: 640px) {
      .kockkroch-intro__emblem {
        width: 130px;
        height: 160px;
      }
      .kockkroch-intro__skip {
        top: 16px;
        right: 16px;
        padding: 6px 10px;
        font-size: 10px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .kockkroch-intro__emblem .k-stroke,
      .kockkroch-intro__emblem .k-shard,
      .kockkroch-intro__grid,
      .kockkroch-intro__scanline {
        animation: none !important;
        stroke-dashoffset: 0 !important;
        opacity: 1 !important;
        transform: none !important;
      }
    }
  </style>

  <div
    id="kockkroch-intro"
    class="kockkroch-intro"
    data-frequency="{{ intro_frequency }}"
    aria-hidden="false"
    role="dialog"
    aria-label="KOCKKROCH"
  >
    <!-- Dark Background Atmosphere -->
    <div class="kockkroch-intro__backdrop">
      <div class="kockkroch-intro__grid"></div>
      <div class="kockkroch-intro__scanline"></div>
      <div class="kockkroch-intro__noise"></div>
    </div>

    <!-- Skip Button -->
    <button
      id="kockkroch-intro-skip"
      class="kockkroch-intro__skip"
      type="button"
      aria-label="Skip Intro"
    >
      <span>SKIP</span>
      <kbd>ESC</kbd>
    </button>

    <!-- Center Stage Container (Pure Emblem Only) -->
    <div class="kockkroch-intro__stage">
      <div class="kockkroch-intro__emblem-wrap">
        <svg
          class="kockkroch-intro__emblem"
          viewBox="0 0 63.80 78.70"
          xmlns="http://www.w3.org/2000/svg"
        >
          <!-- Wireframe Facet Paths -->
          <path class="k-stroke k-s1" d="M 41.53 22.11 L 36.08 13.65 L 31.23 10.26 L 27.25 13.52 L 22.24 22.35 L 41.53 22.11" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          <path class="k-stroke k-s2" d="M 19.29 42.31 L 22.15 23.82 L 41.75 23.59 L 45.28 42.16 L 45.39 50.43 L 36.21 30.32 L 26.88 49.74 L 41.50 63.08 L 39.25 69.79 L 33.73 74.57 L 26.82 69.97 L 22.36 61.04 L 19.29 42.31" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          <path class="k-stroke k-s3" d="M 54.00 72.64 L 36.06 34.54 L 28.81 49.45 L 54.00 72.64" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          <path class="k-stroke k-s4" d="M 18.62 33.19 L 20.57 25.22 L 11.64 22.19 L 4.25 49.24 L 4.00 74.70 L 8.20 53.28 L 15.17 40.55 L 12.35 29.00 L 18.62 33.19" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          <path class="k-stroke k-s5" d="M 40.95 4.00 L 54.18 14.99 L 41.80 7.23 L 36.47 12.38 L 32.64 9.65 L 40.95 4.00" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          <path class="k-stroke k-s6" d="M 20.87 4.02 L 7.63 15.00 L 20.02 7.25 L 26.25 12.34 L 29.45 9.70 L 20.87 4.02" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          <path class="k-stroke k-s7" d="M 26.25 12.35 L 20.61 5.55 L 29.45 9.70" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          <path class="k-stroke k-s8" d="M 36.47 12.38 L 41.49 5.36 L 32.64 9.65" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          <path class="k-stroke k-s9" d="M 27.73 13.55 L 35.33 13.45 L 22.66 22.19 L 41.08 21.95 L 27.73 13.55" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          <path class="k-stroke k-s10" d="M 18.62 33.19 L 11.82 22.69 L 12.35 29.00 L 8.37 34.17 L 15.12 40.35 L 4.25 49.24 L 8.20 53.28 L 5.05 57.78 L 4.01 73.99" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          <path class="k-stroke k-s11" d="M 45.18 32.74 L 43.22 24.78 L 52.16 21.74 L 59.55 48.80 L 59.80 74.25 L 55.60 52.83 L 48.63 40.10 L 51.29 28.59 L 45.18 32.74" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          <path class="k-stroke k-s12" d="M 59.68 73.63 L 58.52 57.45 L 55.60 52.83 L 59.37 48.15 L 49.07 39.85 L 55.21 32.93 L 51.45 28.55 L 52.09 22.41 L 45.18 32.74" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          <path class="k-stroke k-s13" d="M 41.59 23.79 L 20.25 41.53 L 27.87 29.41 L 22.90 24.22 L 41.40 30.39 L 45.18 41.65 L 42.17 43.22" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          <path class="k-stroke k-s14" d="M 22.36 61.04 L 40.38 66.43" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          <path class="k-stroke k-s15" d="M 19.36 42.76 L 34.78 69.07 L 26.88 49.74" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          
          <!-- Signature Red Accent Blade/Shard -->
          <path class="k-shard" d="M 32.00 48.96 L 51.95 69.96 L 38.88 51.18 L 36.14 37.94 L 32.00 48.96 Z" fill="#E3000F" stroke="#E3000F" stroke-width="0.8" stroke-linejoin="round" />
        </svg>
      </div>
    </div>

    <!-- Dual Split Shutters for Smooth Curtain Exit Reveal -->
    <div class="kockkroch-intro__shutter-top"></div>
    <div class="kockkroch-intro__shutter-bottom"></div>
  </div>

  <script id="kockkroch-intro-script">
    (function () {
      'use strict';
      const STORAGE_KEY = 'kockkroch_intro_seen';
      const INTRO_DURATION_MS = 1900;

      function initKockkrochIntro() {
        const introEl = document.getElementById('kockkroch-intro');
        if (!introEl) return;

        // Skip in Shopify Theme Customizer editor view so merchant can design freely
        if (window.Shopify && window.Shopify.designMode) {
          introEl.classList.add('kockkroch-intro--hidden');
          return;
        }

        const frequency = introEl.getAttribute('data-frequency') || 'always';
        if (frequency === 'once' && sessionStorage.getItem(STORAGE_KEY)) {
          introEl.classList.add('kockkroch-intro--hidden');
          return;
        }

        document.body.classList.add('kockkroch-intro-active');
        let isExited = false;

        function completeIntro() {
          if (isExited) return;
          isExited = true;

          try {
            sessionStorage.setItem(STORAGE_KEY, 'true');
          } catch (e) {}

          introEl.classList.add('kockkroch-intro--exiting');
          document.body.classList.remove('kockkroch-intro-active');

          document.dispatchEvent(
            new CustomEvent('kockkroch:intro:complete', { bubbles: true })
          );

          setTimeout(function () {
            introEl.classList.add('kockkroch-intro--hidden');
          }, 750);
        }

        const autoExitTimer = setTimeout(completeIntro, INTRO_DURATION_MS);

        const skipBtn = document.getElementById('kockkroch-intro-skip');
        if (skipBtn) {
          skipBtn.addEventListener('click', function (e) {
            e.preventDefault();
            clearTimeout(autoExitTimer);
            completeIntro();
          });
        }

        function onKeyDown(e) {
          if (e.key === 'Escape' || e.keyCode === 27) {
            clearTimeout(autoExitTimer);
            completeIntro();
            window.removeEventListener('keydown', onKeyDown);
          }
        }
        window.addEventListener('keydown', onKeyDown);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initKockkrochIntro);
      } else {
        initKockkrochIntro();
      }
    })();
  </script>
{%- endif -%}
