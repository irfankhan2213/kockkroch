{% comment %}
  KOCKKROCH (KOCX KROCH) — Pure Logo Intro Animation
  Fearless from Origin • Built to Survive
{% endcomment %}

{%- liquid
  assign enable_intro = settings.enable_intro_animation
  if enable_intro == nil
    assign enable_intro = true
  endif

  assign intro_frequency = settings.intro_frequency | default: 'always'
-%}

{%- if enable_intro -%}
  {{ 'kockkroch-intro.css' | asset_url | stylesheet_tag }}

  <div
    id="kockkroch-intro"
    class="kockkroch-intro"
    data-frequency="{{ intro_frequency }}"
    aria-hidden="false"
    role="dialog"
    aria-label="KOCKKROCH"
  >
    <!-- Dark Background Atmosphere -->
    <div class="kockkroch-intro__backdrop">
      <div class="kockkroch-intro__grid"></div>
      <div class="kockkroch-intro__scanline"></div>
      <div class="kockkroch-intro__noise"></div>
    </div>

    <!-- Skip Button -->
    <button
      id="kockkroch-intro-skip"
      class="kockkroch-intro__skip"
      type="button"
      aria-label="Skip Intro"
    >
      <span>SKIP</span>
      <kbd>ESC</kbd>
    </button>

    <!-- Center Stage Container (Pure Emblem Only) -->
    <div class="kockkroch-intro__stage">
      <div class="kockkroch-intro__emblem-wrap">
        <svg
          class="kockkroch-intro__emblem"
          viewBox="0 0 63.80 78.70"
          xmlns="http://www.w3.org/2000/svg"
        >
          <!-- Wireframe Facet Paths -->
          <path class="k-stroke k-s1" d="M 41.53 22.11 L 36.08 13.65 L 31.23 10.26 L 27.25 13.52 L 22.24 22.35 L 41.53 22.11" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          <path class="k-stroke k-s2" d="M 19.29 42.31 L 22.15 23.82 L 41.75 23.59 L 45.28 42.16 L 45.39 50.43 L 36.21 30.32 L 26.88 49.74 L 41.50 63.08 L 39.25 69.79 L 33.73 74.57 L 26.82 69.97 L 22.36 61.04 L 19.29 42.31" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          <path class="k-stroke k-s3" d="M 54.00 72.64 L 36.06 34.54 L 28.81 49.45 L 54.00 72.64" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          <path class="k-stroke k-s4" d="M 18.62 33.19 L 20.57 25.22 L 11.64 22.19 L 4.25 49.24 L 4.00 74.70 L 8.20 53.28 L 15.17 40.55 L 12.35 29.00 L 18.62 33.19" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          <path class="k-stroke k-s5" d="M 40.95 4.00 L 54.18 14.99 L 41.80 7.23 L 36.47 12.38 L 32.64 9.65 L 40.95 4.00" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          <path class="k-stroke k-s6" d="M 20.87 4.02 L 7.63 15.00 L 20.02 7.25 L 26.25 12.34 L 29.45 9.70 L 20.87 4.02" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          <path class="k-stroke k-s7" d="M 26.25 12.35 L 20.61 5.55 L 29.45 9.70" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          <path class="k-stroke k-s8" d="M 36.47 12.38 L 41.49 5.36 L 32.64 9.65" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          <path class="k-stroke k-s9" d="M 27.73 13.55 L 35.33 13.45 L 22.66 22.19 L 41.08 21.95 L 27.73 13.55" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          <path class="k-stroke k-s10" d="M 18.62 33.19 L 11.82 22.69 L 12.35 29.00 L 8.37 34.17 L 15.12 40.35 L 4.25 49.24 L 8.20 53.28 L 5.05 57.78 L 4.01 73.99" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          <path class="k-stroke k-s11" d="M 45.18 32.74 L 43.22 24.78 L 52.16 21.74 L 59.55 48.80 L 59.80 74.25 L 55.60 52.83 L 48.63 40.10 L 51.29 28.59 L 45.18 32.74" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          <path class="k-stroke k-s12" d="M 59.68 73.63 L 58.52 57.45 L 55.60 52.83 L 59.37 48.15 L 49.07 39.85 L 55.21 32.93 L 51.45 28.55 L 52.09 22.41 L 45.18 32.74" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          <path class="k-stroke k-s13" d="M 41.59 23.79 L 20.25 41.53 L 27.87 29.41 L 22.90 24.22 L 41.40 30.39 L 45.18 41.65 L 42.17 43.22" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          <path class="k-stroke k-s14" d="M 22.36 61.04 L 40.38 66.43" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          <path class="k-stroke k-s15" d="M 19.36 42.76 L 34.78 69.07 L 26.88 49.74" fill="none" stroke="#FFFFFF" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          
          <!-- Signature Red Accent Blade/Shard -->
          <path class="k-shard" d="M 32.00 48.96 L 51.95 69.96 L 38.88 51.18 L 36.14 37.94 L 32.00 48.96 Z" fill="#E3000F" stroke="#E3000F" stroke-width="0.8" stroke-linejoin="round" />
        </svg>
      </div>
    </div>

    <!-- Dual Split Shutters for Smooth Curtain Exit Reveal -->
    <div class="kockkroch-intro__shutter-top"></div>
    <div class="kockkroch-intro__shutter-bottom"></div>
  </div>

  <script src="{{ 'kockkroch-intro.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
