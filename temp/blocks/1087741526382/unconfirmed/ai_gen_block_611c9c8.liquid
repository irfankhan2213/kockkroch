{% doc %}
  @prompt
    Create a mobile-friendly product showcase section to replace my K13 Category Strip, matching my theme's existing visual style. Include an editable heading and collection picker that displays real products from the selected collection. Use a clean two-column grid on mobile and four columns on desktop, with consistent product image ratios, readable product titles and prices, comfortable spacing, and tappable product cards linking to their product pages. Keep images contained without horizontal page overflow. Allow editing product count, image ratio, spacing, colors, and column counts. If no collection is selected, show an editor placeholder inviting me to choose one.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-showcase-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    box-sizing: border-box;
    padding: {{ block.settings.section_spacing }}px 0;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }
  .ai-showcase-{{ ai_gen_id }} *,
  .ai-showcase-{{ ai_gen_id }} *::before,
  .ai-showcase-{{ ai_gen_id }} *::after { box-sizing: border-box; }
  .ai-showcase-{{ ai_gen_id }}__inner { width: 100%; min-width: 0; }
  .ai-showcase-{{ ai_gen_id }}__heading {
    margin: 0 0 {{ block.settings.grid_gap }}px;
    color: inherit;
    font-family: var(--font-heading--family, sans-serif);
    font-size: clamp(24px, 4vw, 42px);
    font-weight: 600;
    line-height: 1.08;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  .ai-showcase-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.mobile_columns }}, minmax(0, 1fr));
    gap: {{ block.settings.grid_gap }}px;
    width: 100%;
    min-width: 0;
  }
  .ai-showcase-{{ ai_gen_id }}__card { display: block; min-width: 0; color: inherit; text-decoration: none; }
  .ai-showcase-{{ ai_gen_id }}__media {
    width: 100%;
    aspect-ratio: {{ block.settings.image_ratio }};
    overflow: hidden;
    background: {{ block.settings.image_background }};
  }
  .ai-showcase-{{ ai_gen_id }}__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .ai-showcase-{{ ai_gen_id }}__title {
    display: block;
    margin: 10px 0 4px;
    color: inherit;
    font-size: 14px;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  .ai-showcase-{{ ai_gen_id }}__price { display: block; font-size: 14px; line-height: 1.4; }
  .ai-showcase-{{ ai_gen_id }}__card:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .ai-showcase-{{ ai_gen_id }}__empty {
    width: 100%;
    padding: 34px 18px;
    border: 1px dashed {{ block.settings.text_color }};
    color: {{ block.settings.text_color }};
    text-align: center;
    font-size: 14px;
  }
  .ai-showcase-{{ ai_gen_id }}__placeholder { width: 100%; aspect-ratio: {{ block.settings.image_ratio }}; background: {{ block.settings.image_background }}; }
  .ai-showcase-{{ ai_gen_id }}__placeholder svg { display: block; width: 100%; height: 100%; }
  @media screen and (min-width: 750px) {
    .ai-showcase-{{ ai_gen_id }}__grid { grid-template-columns: repeat({{ block.settings.desktop_columns }}, minmax(0, 1fr)); }
  }
{% endstyle %}

<div class="ai-showcase-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-showcase-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}<h2 class="ai-showcase-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
    {% if block.settings.collection != blank %}
      {% if block.settings.collection.products_count > 0 %}
        <div class="ai-showcase-{{ ai_gen_id }}__grid">
          {% for product in block.settings.collection.products limit: block.settings.product_count %}
            <a class="ai-showcase-{{ ai_gen_id }}__card" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              <div class="ai-showcase-{{ ai_gen_id }}__media">
                {% if product.featured_image %}
                  {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '240, 360, 540, 720, 900', alt: product.featured_image.alt | default: product.title | escape }}
                {% else %}
                  <div class="ai-showcase-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
                {% endif %}
              </div>
              <span class="ai-showcase-{{ ai_gen_id }}__title">{{ product.title | escape }}</span>
              <span class="ai-showcase-{{ ai_gen_id }}__price">{{ product.price | money }}</span>
            </a>
          {% endfor %}
        </div>
      {% else %}
        <div class="ai-showcase-{{ ai_gen_id }}__empty">This collection has no products to display yet.</div>
      {% endif %}
    {% elsif request.design_mode %}
      <div class="ai-showcase-{{ ai_gen_id }}__empty">Choose a collection in this block’s settings to display its products.</div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Product showcase",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the collection" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_count", "label": "Products to show", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "header", "content": "Grid layout" },
    { "type": "select", "id": "mobile_columns", "label": "Mobile columns", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }], "default": "2" },
    { "type": "select", "id": "desktop_columns", "label": "Desktop columns", "options": [{ "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }], "default": "4" },
    { "type": "select", "id": "image_ratio", "label": "Image ratio", "options": [{ "value": "1 / 1", "label": "Square" }, { "value": "4 / 5", "label": "Portrait" }, { "value": "3 / 2", "label": "Landscape" }], "default": "4 / 5" },
    { "type": "range", "id": "grid_gap", "label": "Grid spacing", "min": 8, "max": 40, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "section_spacing", "label": "Section spacing", "min": 0, "max": 64, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F4F2ED" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#101012" },
    { "type": "color", "id": "image_background", "label": "Image background", "default": "#E7E4DB" }
  ],
  "presets": [{ "name": "Product showcase" }],
  "tag": null,
  "class": "product-showcase-block"
}
{% endschema %}