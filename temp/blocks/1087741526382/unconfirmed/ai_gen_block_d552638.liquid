{% doc %}
  @prompt
    Create a horizontally scrolling announcement bar to replace the current static announcement bar. Use a smooth continuous right-to-left text loop, matching the existing announcement bar's appearance. Keep announcement text, colors, and scrolling speed editable. Pause scrolling on hover and respect reduced-motion preferences.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    font-family: inherit;
  }

  .ai-announcement-{{ ai_gen_id }}__viewport {
    overflow: hidden;
    width: 100%;
    padding: 10px 0;
  }

  .ai-announcement-{{ ai_gen_id }}__track {
    display: flex;
    width: max-content;
    animation: ai-announcement-scroll-{{ ai_gen_id }} {{ block.settings.scroll_duration }}s linear infinite;
    will-change: transform;
  }

  .ai-announcement-{{ ai_gen_id }}:hover .ai-announcement-{{ ai_gen_id }}__track,
  .ai-announcement-{{ ai_gen_id }}:focus-within .ai-announcement-{{ ai_gen_id }}__track {
    animation-play-state: paused;
  }

  .ai-announcement-{{ ai_gen_id }}__group {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
  }

  .ai-announcement-{{ ai_gen_id }}__item {
    flex: 0 0 auto;
    padding: 0 28px;
    color: inherit;
    font-size: 12px;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .ai-announcement-{{ ai_gen_id }}__separator {
    opacity: 0.75;
    font-size: 10px;
  }

  @keyframes ai-announcement-scroll-{{ ai_gen_id }} {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-announcement-{{ ai_gen_id }}__track {
      animation: none;
      width: 100%;
      justify-content: center;
      will-change: auto;
    }

    .ai-announcement-{{ ai_gen_id }}__group[aria-hidden="true"] {
      display: none;
    }

    .ai-announcement-{{ ai_gen_id }}__item {
      white-space: normal;
      text-align: center;
    }
  }
{% endstyle %}

<div class="ai-announcement-{{ ai_gen_id }}" style="width: {{ block.settings.desktop_width_percent }}%;" {{ block.shopify_attributes }}>
  <div class="ai-announcement-{{ ai_gen_id }}__viewport" aria-label="{{ block.settings.announcement_text | escape }}">
    <div class="ai-announcement-{{ ai_gen_id }}__track">
      {% for copy in (1..2) %}
        <div class="ai-announcement-{{ ai_gen_id }}__group" {% if copy == 2 %}aria-hidden="true"{% endif %}>
          <span class="ai-announcement-{{ ai_gen_id }}__item">{{ block.settings.announcement_text | escape }}</span>
          <span class="ai-announcement-{{ ai_gen_id }}__item ai-announcement-{{ ai_gen_id }}__separator" aria-hidden="true">✦</span>
          <span class="ai-announcement-{{ ai_gen_id }}__item">{{ block.settings.announcement_text | escape }}</span>
          <span class="ai-announcement-{{ ai_gen_id }}__item ai-announcement-{{ ai_gen_id }}__separator" aria-hidden="true">✦</span>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Scrolling announcement",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "FEARLESS FROM ORIGIN • BUILT TO SURVIVE"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#101012"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "scroll_duration",
      "label": "Loop duration",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Scrolling announcement"
    }
  ],
  "tag": null,
  "class": "scrolling-announcement-block"
}
{% endschema %}