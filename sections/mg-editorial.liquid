{% comment %} KOCKKROCH — Editorial banner (NEW VIBES language) {% endcomment %}
<section class="mg-edit">
  <div class="mg-edit__grid">
    <div class="mg-edit__copy mg-reveal">
      <span class="mg-eyebrow">{{ section.settings.eyebrow | default: 'NEW SEASON — DROP 013' }}</span>
      <h2>{{ section.settings.title_a | default: 'BUILT TO' }}<br>{{ section.settings.title_b | default: 'SURVIVE.' }}</h2>
      <p>{{ section.settings.copy | default: 'Dense ring-spun cottons, bar-tacked stress points and boxy cuts that hold shape for years. Discover everything new and now.' }}</p>
      <div><a href="{{ section.settings.link | default: '/collections/all' }}" class="mg-btn-dark">{{ section.settings.cta | default: 'EXPLORE COLLECTION' }}</a></div>
    </div>
    <div class="mg-edit__media">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 1400 }}" alt="Editorial" loading="lazy">
      {% else %}
        <img src="{{ 'kockkroch-editorial-overshirt.webp' | asset_url }}" alt="Editorial" loading="lazy">
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "MG Editorial Banner",
  "tag": "section",
  "enabled_on": { "templates": ["*"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "NEW SEASON — DROP 013" },
    { "type": "text", "id": "title_a", "label": "Title line 1", "default": "BUILT TO" },
    { "type": "text", "id": "title_b", "label": "Title line 2", "default": "SURVIVE." },
    { "type": "textarea", "id": "copy", "label": "Copy", "default": "Dense ring-spun cottons, bar-tacked stress points and boxy cuts that hold shape for years. Discover everything new and now." },
    { "type": "text", "id": "cta", "label": "CTA", "default": "EXPLORE COLLECTION" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "MG Editorial Banner" }]
}
{% endschema %}
