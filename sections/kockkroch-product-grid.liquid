{% comment %}
  KOCKKROCH — Tall 2:3 Editorial Product Grid
  Inspired by ssstein & 3sixteen
{% endcomment %}

<section id="kk-catalog-section" class="kk-catalog" data-section-id="{{ section.id }}">
  <div class="kk-container">
    <div class="kk-section-header">
      <div class="kk-section-header__meta">
        <span class="kk-section-header__subtitle">{{ section.settings.subtitle | default: 'COLLECTION 01' }}</span>
        <h2 class="kk-section-header__title">{{ section.settings.title | default: 'SELECTED WORKS' }}</h2>
      </div>
      <a href="{{ section.settings.view_all_link | default: '/collections/all' }}" class="kk-section-header__link">
        {{ section.settings.link_text | default: 'VIEW ENTIRE CATALOG →' }}
      </a>
    </div>

    <div class="kk-product-matrix">
      {% assign target_collection = collections[section.settings.collection] %}
      {% if target_collection != blank and target_collection.products.size > 0 %}
        {% for product in target_collection.products limit: section.settings.products_to_show | default: 4 %}
          {% liquid
            assign clean_title = product.title | remove: '450 GSM ' | remove: '280 GSM ' | remove: '260 GSM ' | remove: 'ZERO-TORQUE ' | remove: 'Zero-Torque ' | remove: 'CORDURA ' | remove: '450 gsm ' | remove: '280 gsm ' | strip
            assign clean_category = product.type | default: 'ARCHIVAL' | remove: '450 GSM' | remove: '280 GSM' | remove: 'ZERO-TORQUE' | remove: 'FLEECE' | strip
            if clean_category == blank or clean_category == 'ARCHIVAL'
              if product.title contains 'HOODIE' or product.title contains 'Hoodie'
                assign clean_category = 'ARCHIVAL KNITWEAR'
              elsif product.title contains 'TEE' or product.title contains 'Tee'
                assign clean_category = 'COTTON JERSEY'
              elsif product.title contains 'TROUSER' or product.title contains 'Trouser' or product.title contains 'CARGO' or product.title contains 'Cargo' or product.title contains 'Pants'
                assign clean_category = 'TAILORED TROUSERS'
              elsif product.title contains 'SHIRT' or product.title contains 'Shirt'
                assign clean_category = 'LUXURY SHIRTING'
              else
                assign clean_category = 'COLLECTION 01'
              endif
            endif
          %}
          <div class="kk-prod-card">
            <a href="{{ product.url }}" class="kk-prod-card__media">
              <img
                src="{{ product.featured_image | image_url: width: 900 }}"
                alt="{{ clean_title | escape }}"
                class="kk-prod-card__img"
                loading="lazy"
              >
              <div class="kk-prod-card__quick-add">
                {% for variant in product.variants limit: 4 %}
                  <button type="button" class="kk-prod-card__size-opt" onclick="location.href='{{ product.url }}?variant={{ variant.id }}'">
                    {{ variant.title }}
                  </button>
                {% else %}
                  <span class="kk-prod-card__size-opt">QUICK VIEW</span>
                {% endfor %}
              </div>
            </a>
            <div class="kk-prod-card__info">
              <span class="kk-prod-card__category">{{ clean_category }}</span>
              <h3 class="kk-prod-card__title">
                <a href="{{ product.url }}">{{ clean_title }}</a>
              </h3>
              <span class="kk-prod-card__price">{{ product.price | money }}</span>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <!-- Default Editorial 4-Product Catalog (The Frankie Shop / ssstein Aesthetic) -->
        <div class="kk-prod-card">
          <a href="/products/hoodie" class="kk-prod-card__media">
            <img src="{{ 'kockkroch-editorial-hoodie.webp' | asset_url }}" alt="Archival Boxy Hoodie" class="kk-prod-card__img" loading="lazy">
            <div class="kk-prod-card__quick-add">
              <button type="button" class="kk-prod-card__size-opt">S</button>
              <button type="button" class="kk-prod-card__size-opt">M</button>
              <button type="button" class="kk-prod-card__size-opt">L</button>
              <button type="button" class="kk-prod-card__size-opt">XL</button>
            </div>
          </a>
          <div class="kk-prod-card__info">
            <span class="kk-prod-card__category">ARCHIVAL KNITWEAR</span>
            <h3 class="kk-prod-card__title"><a href="/products/hoodie">ARCHIVAL BOXY HOODIE</a></h3>
            <span class="kk-prod-card__price">$380 USD</span>
          </div>
        </div>

        <div class="kk-prod-card">
          <a href="/products/heavyweight-tee" class="kk-prod-card__media">
            <img src="{{ 'kockkroch-editorial-tee.webp' | asset_url }}" alt="Signature Boxy Crewneck Tee" class="kk-prod-card__img" loading="lazy">
            <div class="kk-prod-card__quick-add">
              <button type="button" class="kk-prod-card__size-opt">S</button>
              <button type="button" class="kk-prod-card__size-opt">M</button>
              <button type="button" class="kk-prod-card__size-opt">L</button>
              <button type="button" class="kk-prod-card__size-opt">XL</button>
            </div>
          </a>
          <div class="kk-prod-card__info">
            <span class="kk-prod-card__category">COTTON JERSEY</span>
            <h3 class="kk-prod-card__title"><a href="/products/heavyweight-tee">SIGNATURE BOXY CREWNECK</a></h3>
            <span class="kk-prod-card__price">$180 USD</span>
          </div>
        </div>

        <div class="kk-prod-card">
          <a href="/products/ripstop-cargo" class="kk-prod-card__media">
            <img src="{{ 'kockkroch-editorial-cargo.webp' | asset_url }}" alt="Pleated Wide-Leg Trouser" class="kk-prod-card__img" loading="lazy">
            <div class="kk-prod-card__quick-add">
              <button type="button" class="kk-prod-card__size-opt">28</button>
              <button type="button" class="kk-prod-card__size-opt">30</button>
              <button type="button" class="kk-prod-card__size-opt">32</button>
              <button type="button" class="kk-prod-card__size-opt">34</button>
            </div>
          </a>
          <div class="kk-prod-card__info">
            <span class="kk-prod-card__category">TAILORED TROUSERS</span>
            <h3 class="kk-prod-card__title"><a href="/products/ripstop-cargo">PLEATED WIDE-LEG TROUSER</a></h3>
            <span class="kk-prod-card__price">$320 USD</span>
          </div>
        </div>

        <div class="kk-prod-card">
          <a href="/products/poplin-overshirt" class="kk-prod-card__media">
            <img src="{{ 'kockkroch-editorial-overshirt.webp' | asset_url }}" alt="Archival Poplin Overshirt" class="kk-prod-card__img" loading="lazy">
            <div class="kk-prod-card__quick-add">
              <button type="button" class="kk-prod-card__size-opt">S</button>
              <button type="button" class="kk-prod-card__size-opt">M</button>
              <button type="button" class="kk-prod-card__size-opt">L</button>
              <button type="button" class="kk-prod-card__size-opt">XL</button>
            </div>
          </a>
          <div class="kk-prod-card__info">
            <span class="kk-prod-card__category">LUXURY SHIRTING</span>
            <h3 class="kk-prod-card__title"><a href="/products/poplin-overshirt">ARCHIVAL POPLIN OVERSHIRT</a></h3>
            <span class="kk-prod-card__price">$290 USD</span>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KOCKKROCH Product Grid",
  "tag": "section",
  "class": "section-kockkroch-product-grid",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "COLLECTION 01"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "SELECTED WORKS"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "VIEW ENTIRE CATALOG →"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to Show",
      "min": 4,
      "max": 16,
      "step": 4,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "KOCKKROCH Product Grid"
    }
  ]
}
{% endschema %}
