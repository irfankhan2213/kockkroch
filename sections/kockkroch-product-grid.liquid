{% comment %}
  KOCKKROCH (KOCX KROCH) — Clean Luxury Product Grid
  Fearless from Origin • Built to Survive • California
{% endcomment %}

<section class="kk-section" id="kockkroch-products" data-section-id="{{ section.id }}">
  <div class="kk-section-header">
    <div class="kk-section-header__meta">
      <span class="kk-tag kk-tag--red">{{ section.settings.badge | default: 'DROP 013' }}</span>
      <h2 class="kk-section-header__title">
        {{ section.settings.title | default: 'LATEST RELEASES' }}
      </h2>
    </div>
    {% if section.settings.view_all_link != blank %}
      <a href="{{ section.settings.view_all_link }}" class="kk-section-header__link">
        <span>VIEW ALL ({{ section.settings.collection.all_products_count | default: '12' }}) →</span>
      </a>
    {% endif %}
  </div>

  <div class="kk-product-grid">
    {% assign collection = collections[section.settings.collection] %}
    {% if collection != blank and collection.products_count > 0 %}
      {% for product in collection.products limit: section.settings.products_to_show %}
        <div class="kk-product-card">
          <div class="kk-product-card__media">
            <a href="{{ product.url }}">
              {% if product.featured_image != blank %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.title | escape }}"
                  class="kk-product-card__img"
                  loading="lazy"
                >
                {% if product.images.size > 1 %}
                  <img
                    src="{{ product.images[1] | image_url: width: 600 }}"
                    alt="{{ product.title | escape }}"
                    class="kk-product-card__img-hover"
                    loading="lazy"
                  >
                {% endif %}
              {% else %}
                <div class="kk-product-card__img" style="background: radial-gradient(circle at center, #FFFFFF 0%, #F0F0F4 100%);"></div>
              {% endif %}
            </a>
            <div class="kk-product-card__badge">
              {% if product.compare_at_price > product.price %}
                SALE
              {% else %}
                DROP 013
              {% endif %}
            </div>

            <!-- Clean Quick Size Selector -->
            {% if product.variants.size > 1 %}
              <div class="kk-product-card__sizes">
                {% for variant in product.variants limit: 5 %}
                  <a
                    href="{{ product.url }}?variant={{ variant.id }}"
                    class="kk-size-pill"
                  >
                    {{ variant.title }}
                  </a>
                {% endfor %}
              </div>
            {% endif %}
          </div>

          <div class="kk-product-card__info">
            <span class="kk-product-card__vendor">{{ product.vendor | default: 'KOCKKROCH' }}</span>
            <h3 class="kk-product-card__title">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h3>
            
            <div class="kk-product-card__price-row">
              <span class="kk-product-card__price">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}
                <span class="kk-product-card__compare">{{ product.compare_at_price | money }}</span>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    {% else %}
      <!-- Clean Default Product Demos with Real Brand Assets -->
      <div class="kk-product-card">
        <div class="kk-product-card__media">
          <a href="/products/kockkroch-acid-wash-240gsm-oversized-t-shirt">
            <img src="{{ 'kockkroch-acid-wash-240gsm-front.png' | asset_url }}" alt="KOCKKROCH Standing Out Acid Wash 240 GSM Oversized T-Shirt" class="kk-product-card__img" loading="lazy">
            <img src="{{ 'kockkroch-acid-wash-240gsm-back.png' | asset_url }}" alt="KOCKKROCH Exoskeleton Back Shield" class="kk-product-card__img-hover" loading="lazy">
          </a>
          <span class="kk-product-card__badge">NEW DROP</span>
          <div class="kk-product-card__sizes">
            <a href="/products/kockkroch-acid-wash-240gsm-oversized-t-shirt" class="kk-size-pill">S</a>
            <a href="/products/kockkroch-acid-wash-240gsm-oversized-t-shirt" class="kk-size-pill">M</a>
            <a href="/products/kockkroch-acid-wash-240gsm-oversized-t-shirt" class="kk-size-pill">L</a>
            <a href="/products/kockkroch-acid-wash-240gsm-oversized-t-shirt" class="kk-size-pill">XL</a>
          </div>
        </div>
        <div class="kk-product-card__info">
          <span class="kk-product-card__vendor">KOCKKROCH • 240 GSM</span>
          <h3 class="kk-product-card__title"><a href="/products/kockkroch-acid-wash-240gsm-oversized-t-shirt">'STANDING OUT' ACID WASH TEE</a></h3>
          <div class="kk-product-card__price-row">
            <span class="kk-product-card__price">₹2,499</span>
            <span class="kk-product-card__compare">₹3,499</span>
          </div>
        </div>
      </div>

      <div class="kk-product-card">
        <div class="kk-product-card__media">
          <a href="/products/kockkroch-kok-f-180gsm-oversized-t-shirt">
            <img src="{{ 'kockkroch-kok-f-180gsm-front.png' | asset_url }}" alt="KOCKKROCH Gangster Flying 180 GSM Oversized T-Shirt" class="kk-product-card__img" loading="lazy">
            <img src="{{ 'kockkroch-kok-f-180gsm-back.png' | asset_url }}" alt="KOCKKROCH Gangster Flying Back Statement" class="kk-product-card__img-hover" loading="lazy">
          </a>
          <span class="kk-product-card__badge">BESTSELLER</span>
          <div class="kk-product-card__sizes">
            <a href="/products/kockkroch-kok-f-180gsm-oversized-t-shirt" class="kk-size-pill">S</a>
            <a href="/products/kockkroch-kok-f-180gsm-oversized-t-shirt" class="kk-size-pill">M</a>
            <a href="/products/kockkroch-kok-f-180gsm-oversized-t-shirt" class="kk-size-pill">L</a>
            <a href="/products/kockkroch-kok-f-180gsm-oversized-t-shirt" class="kk-size-pill">XL</a>
          </div>
        </div>
        <div class="kk-product-card__info">
          <span class="kk-product-card__vendor">KOCKKROCH • 180 GSM</span>
          <h3 class="kk-product-card__title"><a href="/products/kockkroch-kok-f-180gsm-oversized-t-shirt">'GANGSTER FLYING' OVERSIZED TEE</a></h3>
          <div class="kk-product-card__price-row">
            <span class="kk-product-card__price">₹1,899</span>
            <span class="kk-product-card__compare">₹2,599</span>
          </div>
        </div>
      </div>

      <div class="kk-product-card">
        <div class="kk-product-card__media">
          <a href="/products/kockkroch-side-p-210gsm-oversized-t-shirt">
            <img src="{{ 'kockkroch-side-p-210gsm-front.png' | asset_url }}" alt="KOCKKROCH Numerical Code 210 GSM Oversized T-Shirt" class="kk-product-card__img" loading="lazy">
            <img src="{{ 'kockkroch-side-p-210gsm-back.png' | asset_url }}" alt="KOCKKROCH Minimal Nape Stripe" class="kk-product-card__img-hover" loading="lazy">
          </a>
          <span class="kk-product-card__badge">DROP 013</span>
          <div class="kk-product-card__sizes">
            <a href="/products/kockkroch-side-p-210gsm-oversized-t-shirt" class="kk-size-pill">S</a>
            <a href="/products/kockkroch-side-p-210gsm-oversized-t-shirt" class="kk-size-pill">M</a>
            <a href="/products/kockkroch-side-p-210gsm-oversized-t-shirt" class="kk-size-pill">L</a>
            <a href="/products/kockkroch-side-p-210gsm-oversized-t-shirt" class="kk-size-pill">XL</a>
          </div>
        </div>
        <div class="kk-product-card__info">
          <span class="kk-product-card__vendor">KOCKKROCH • 210 GSM</span>
          <h3 class="kk-product-card__title"><a href="/products/kockkroch-side-p-210gsm-oversized-t-shirt">'NUMERICAL CODE' OVERSIZED TEE</a></h3>
          <div class="kk-product-card__price-row">
            <span class="kk-product-card__price">₹2,199</span>
            <span class="kk-product-card__compare">₹2,999</span>
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "KOCKKROCH Product Grid",
  "tag": "section",
  "class": "section-kockkroch-products",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Section Tag/Badge",
      "default": "DROP 013"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "LATEST RELEASES"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to Show",
      "min": 4,
      "max": 16,
      "step": 4,
      "default": 8
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    }
  ]
}
{% endschema %}
