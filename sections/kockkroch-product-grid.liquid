{% comment %}
  KOCKKROCH (KOCX KROCH) — Clean Luxury Product Grid
  Fearless from Origin • Built to Survive • California
{% endcomment %}

<section class="kk-section" id="kockkroch-products" data-section-id="{{ section.id }}">
  <div class="kk-section-header">
    <div class="kk-section-header__meta">
      <span class="kk-tag kk-tag--red">{{ section.settings.badge | default: 'DROP 013' }}</span>
      <h2 class="kk-section-header__title">
        {{ section.settings.title | default: 'LATEST RELEASES' }}
      </h2>
    </div>
    {% if section.settings.view_all_link != blank %}
      <a href="{{ section.settings.view_all_link }}" class="kk-section-header__link">
        <span>VIEW ALL ({{ section.settings.collection.all_products_count | default: '12' }}) →</span>
      </a>
    {% endif %}
  </div>

  <div class="kk-product-grid">
    {% assign collection = collections[section.settings.collection] %}
    {% if collection != blank and collection.products_count > 0 %}
      {% for product in collection.products limit: section.settings.products_to_show %}
        <div class="kk-product-card">
          <div class="kk-product-card__media">
            <a href="{{ product.url }}">
              {% if product.featured_image != blank %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.title | escape }}"
                  class="kk-product-card__img"
                  loading="lazy"
                >
                {% if product.images.size > 1 %}
                  <img
                    src="{{ product.images[1] | image_url: width: 600 }}"
                    alt="{{ product.title | escape }}"
                    class="kk-product-card__img-hover"
                    loading="lazy"
                  >
                {% endif %}
              {% else %}
                <div class="kk-product-card__img" style="background: radial-gradient(circle at center, #FFFFFF 0%, #F0F0F4 100%);"></div>
              {% endif %}
            </a>
            <div class="kk-product-card__badge">
              {% if product.compare_at_price > product.price %}
                SALE
              {% else %}
                DROP 013
              {% endif %}
            </div>

            <!-- Clean Quick Size Selector -->
            {% if product.variants.size > 1 %}
              <div class="kk-product-card__sizes">
                {% for variant in product.variants limit: 5 %}
                  <a
                    href="{{ product.url }}?variant={{ variant.id }}"
                    class="kk-size-pill"
                  >
                    {{ variant.title }}
                  </a>
                {% endfor %}
              </div>
            {% endif %}
          </div>

          <div class="kk-product-card__info">
            <span class="kk-product-card__vendor">{{ product.vendor | default: 'KOCKKROCH' }}</span>
            <h3 class="kk-product-card__title">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h3>
            
            <div class="kk-product-card__price-row">
              <span class="kk-product-card__price">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}
                <span class="kk-product-card__compare">{{ product.compare_at_price | money }}</span>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    {% else %}
      <!-- Clean Default Product Demos with Editorial Visuals -->
      <div class="kk-product-card">
        <div class="kk-product-card__media">
          <img src="{{ 'kockkroch-product-tee.webp' | asset_url }}" alt="280 GSM Zero-Torque Boxy Tee" class="kk-product-card__img" loading="lazy">
          <span class="kk-product-card__badge">DROP 013</span>
          <div class="kk-product-card__sizes">
            <a href="/collections/all" class="kk-size-pill">S</a>
            <a href="/collections/all" class="kk-size-pill">M</a>
            <a href="/collections/all" class="kk-size-pill">L</a>
            <a href="/collections/all" class="kk-size-pill">XL</a>
          </div>
        </div>
        <div class="kk-product-card__info">
          <span class="kk-product-card__vendor">KOCKKROCH • 280 GSM</span>
          <h3 class="kk-product-card__title"><a href="/collections/all">280 GSM ZERO-TORQUE BOXY TEE — CHALK WHITE</a></h3>
          <div class="kk-product-card__price-row"><span class="kk-product-card__price">$75.00</span></div>
        </div>
      </div>

      <div class="kk-product-card">
        <div class="kk-product-card__media">
          <img src="{{ 'kockkroch-product-hoodie.webp' | asset_url }}" alt="450 GSM Structured Hoodie" class="kk-product-card__img" loading="lazy">
          <span class="kk-product-card__badge">HEAVYWEIGHT</span>
          <div class="kk-product-card__sizes">
            <a href="/collections/all" class="kk-size-pill">S</a>
            <a href="/collections/all" class="kk-size-pill">M</a>
            <a href="/collections/all" class="kk-size-pill">L</a>
            <a href="/collections/all" class="kk-size-pill">XL</a>
          </div>
        </div>
        <div class="kk-product-card__info">
          <span class="kk-product-card__vendor">KOCKKROCH • 450 GSM</span>
          <h3 class="kk-product-card__title"><a href="/collections/all">450 GSM STRUCTURED HOODIE — JET BLACK</a></h3>
          <div class="kk-product-card__price-row"><span class="kk-product-card__price">$185.00</span></div>
        </div>
      </div>

      <div class="kk-product-card">
        <div class="kk-product-card__media">
          <img src="{{ 'kockkroch-product-cargo.webp' | asset_url }}" alt="Tactical Ripstop Cargo Trouser" class="kk-product-card__img" loading="lazy">
          <span class="kk-product-card__badge">TACTICAL</span>
          <div class="kk-product-card__sizes">
            <a href="/collections/all" class="kk-size-pill">28</a>
            <a href="/collections/all" class="kk-size-pill">30</a>
            <a href="/collections/all" class="kk-size-pill">32</a>
            <a href="/collections/all" class="kk-size-pill">34</a>
          </div>
        </div>
        <div class="kk-product-card__info">
          <span class="kk-product-card__vendor">KOCKKROCH • RIPSTOP</span>
          <h3 class="kk-product-card__title"><a href="/collections/all">TACTICAL RIPSTOP CARGO TROUSER — OBSIDIAN</a></h3>
          <div class="kk-product-card__price-row"><span class="kk-product-card__price">$195.00</span></div>
        </div>
      </div>

      <div class="kk-product-card">
        <div class="kk-product-card__media">
          <img src="{{ 'kockkroch-product-shirt.webp' | asset_url }}" alt="260 GSM Archival Oversized Shirt" class="kk-product-card__img" loading="lazy">
          <span class="kk-product-card__badge">LIMITED</span>
          <div class="kk-product-card__sizes">
            <a href="/collections/all" class="kk-size-pill">S</a>
            <a href="/collections/all" class="kk-size-pill">M</a>
            <a href="/collections/all" class="kk-size-pill">L</a>
            <a href="/collections/all" class="kk-size-pill">XL</a>
          </div>
        </div>
        <div class="kk-product-card__info">
          <span class="kk-product-card__vendor">KOCKKROCH • 260 GSM</span>
          <h3 class="kk-product-card__title"><a href="/collections/all">260 GSM ARCHIVAL OVERSIZED SHIRT — CHALK WHITE</a></h3>
          <div class="kk-product-card__price-row"><span class="kk-product-card__price">$165.00</span></div>
        </div>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "KOCKKROCH Product Grid",
  "tag": "section",
  "class": "section-kockkroch-products",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Section Tag/Badge",
      "default": "DROP 013"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "LATEST RELEASES"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to Show",
      "min": 4,
      "max": 16,
      "step": 4,
      "default": 8
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    }
  ]
}
{% endschema %}
