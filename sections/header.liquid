{% comment %}
  KOCKKROCH (KOCX KROCH) — Flagship Luxury Archival Header
  Engineered for Drop 013 • Built to Survive • California / India
{% endcomment %}

<header id="header-component" class="k13-nav-header" data-sticky="{{ section.settings.enable_sticky_header }}">
  <div class="k13-nav-wrap">
    <!-- Left: Mobile Menu Trigger & Desktop Navigation -->
    <div class="k13-nav-left">
      <button type="button" class="k13-nav-burger" id="k13-menu-toggle" aria-label="Open Navigation Menu">
        <span></span>
        <span></span>
      </button>

      <nav class="k13-desktop-nav" aria-label="Main Navigation">
        {% assign nav_menu = linklists[section.settings.menu] %}
        {% if nav_menu != blank and nav_menu.links.size > 0 %}
          {% for link in nav_menu.links %}
            <a href="{{ link.url }}" class="k13-nav-link{% if link.active %} is-active{% endif %}">{{ link.title | upcase }}</a>
          {% endfor %}
        {% else %}
          <a href="#k13-newin" class="k13-nav-link">DROP 013</a>
          <a href="/products/kockkroch-acid-wash-240gsm-oversized-t-shirt" class="k13-nav-link">240 GSM</a>
          <a href="/products/kockkroch-kok-f-180gsm-oversized-t-shirt" class="k13-nav-link">180 GSM</a>
          <a href="/products/kockkroch-side-p-210gsm-oversized-t-shirt" class="k13-nav-link">210 GSM</a>
          <a href="#k13-wild" class="k13-nav-link">LOOKBOOK</a>
        {% endif %}
      </nav>
    </div>

    <!-- Center: Brand Logo -->
    <div class="k13-nav-center">
      <a href="{{ routes.root_url }}" class="k13-nav-brand" aria-label="KOCKKROCH Home">
        {% if section.settings.logo != blank %}
          <img
            src="{{ section.settings.logo | image_url: width: 360 }}"
            alt="{{ shop.name | default: 'KOCKKROCH' }}"
            class="k13-nav-brand-img"
            width="{{ section.settings.logo_width | default: 140 }}"
            height="auto"
          >
        {% else %}
          <div class="k13-nav-brand-group">
            <svg class="k13-nav-icon-logo" viewBox="0 0 63.80 78.70" fill="none" stroke="currentColor" stroke-width="1.2">
              <path d="M 41.53 22.11 L 36.08 13.65 L 31.23 10.26 L 27.25 13.52 L 22.24 22.35 L 41.53 22.11" />
              <path d="M 19.29 42.31 L 22.15 23.82 L 41.75 23.59 L 45.28 42.16 L 45.39 50.43 L 36.21 30.32 L 26.88 49.74 L 41.50 63.08 L 39.25 69.79 L 33.73 74.57 L 26.82 69.97 L 22.36 61.04 L 19.29 42.31" />
              <path d="M 54.00 72.64 L 36.06 34.54 L 28.81 49.45 L 54.00 72.64" />
              <path d="M 18.62 33.19 L 20.57 25.22 L 11.64 22.19 L 4.25 49.24 L 4.00 74.70 L 8.20 53.28 L 15.17 40.55 L 12.35 29.00 L 18.62 33.19" />
              <path d="M 40.95 4.00 L 54.18 14.99 L 41.80 7.23 L 36.47 12.38 L 32.64 9.65 L 40.95 4.00" />
              <path d="M 20.87 4.02 L 7.63 15.00 L 20.02 7.25 L 26.25 12.34 L 29.45 9.70 L 20.87 4.02" />
              <path d="M 32.00 48.96 L 51.95 69.96 L 38.88 51.18 L 36.14 37.94 L 32.00 48.96 Z" fill="currentColor" />
            </svg>
            <span class="k13-nav-wordmark">KOCK<strong>KROCH</strong></span>
          </div>
        {% endif %}
      </a>
    </div>

    <!-- Right: Region, Search, Cart -->
    <div class="k13-nav-right">
      <span class="k13-nav-region">IN / INR (₹)</span>

      <a href="#k13-newin" class="k13-nav-action" aria-label="Search Collection">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </a>

      <a href="{{ routes.cart_url }}" class="k13-nav-action k13-nav-cart" id="k13-cart-trigger" aria-label="Shopping Cart">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span class="k13-cart-badge" id="k13-cart-count">{{ cart.item_count | default: 0 }}</span>
      </a>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div class="k13-mobile-drawer" id="k13-drawer" aria-hidden="true">
    <div class="k13-drawer-inner">
      <div class="k13-drawer-head">
        <span class="k13-drawer-tag">DROP 013 // CALIBRATED TO SURVIVE</span>
        <button type="button" class="k13-drawer-close" id="k13-drawer-close" aria-label="Close Navigation Menu">✕</button>
      </div>

      <nav class="k13-drawer-nav">
        <a href="#k13-newin" class="k13-drawer-link" onclick="closeK13Drawer()">
          <span class="num">01</span>
          <span class="label">DROP 013 CAPSULE</span>
          <span class="arrow">→</span>
        </a>
        <a href="/products/kockkroch-acid-wash-240gsm-oversized-t-shirt" class="k13-drawer-link" onclick="closeK13Drawer()">
          <span class="num">02</span>
          <span class="label">240 GSM ACID WASH</span>
          <span class="arrow">→</span>
        </a>
        <a href="/products/kockkroch-kok-f-180gsm-oversized-t-shirt" class="k13-drawer-link" onclick="closeK13Drawer()">
          <span class="num">03</span>
          <span class="label">180 GSM JET BLACK</span>
          <span class="arrow">→</span>
        </a>
        <a href="/products/kockkroch-side-p-210gsm-oversized-t-shirt" class="k13-drawer-link" onclick="closeK13Drawer()">
          <span class="num">04</span>
          <span class="label">210 GSM NUMERICAL</span>
          <span class="arrow">→</span>
        </a>
        <a href="#k13-wild" class="k13-drawer-link" onclick="closeK13Drawer()">
          <span class="num">05</span>
          <span class="label">COMMUNITY LOOKBOOK</span>
          <span class="arrow">→</span>
        </a>
        <a href="/collections/all" class="k13-drawer-link" onclick="closeK13Drawer()">
          <span class="num">06</span>
          <span class="label">ALL SILHOUETTES</span>
          <span class="arrow">→</span>
        </a>
      </nav>

      <div class="k13-drawer-foot">
        <div class="k13-drawer-info">
          <span>PRICES IN INR (₹)</span>
          <span>SHIPPING PAN-INDIA</span>
        </div>
        <div class="k13-drawer-social">
          <a href="https://instagram.com/kockkroch" target="_blank" rel="noopener">INSTAGRAM ↗</a>
        </div>
      </div>
    </div>
    <div class="k13-drawer-backdrop" id="k13-drawer-backdrop"></div>
  </div>
</header>

<style>
  .k13-nav-header {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 990;
    background: rgba(244, 242, 237, 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }
  .k13-nav-wrap {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 28px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .k13-nav-left, .k13-nav-right {
    flex: 1;
    display: flex;
    align-items: center;
  }
  .k13-nav-right {
    justify-content: flex-end;
    gap: 18px;
  }
  .k13-desktop-nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .k13-nav-link {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
    color: #0A0A0C;
    text-decoration: none;
    position: relative;
    padding: 4px 0;
    transition: opacity 0.2s ease;
  }
  .k13-nav-link:hover {
    opacity: 0.65;
  }
  .k13-nav-burger {
    display: none;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 6px;
    flex-direction: column;
    gap: 5px;
  }
  .k13-nav-burger span {
    display: block;
    width: 20px;
    height: 1.5px;
    background: #0A0A0C;
    transition: transform 0.2s ease;
  }
  .k13-nav-center {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .k13-nav-brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: #0A0A0C;
  }
  .k13-nav-brand-group {
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }
  .k13-nav-icon-logo {
    width: 22px;
    height: 27px;
    display: block;
  }
  .k13-nav-wordmark {
    font-size: 16px;
    letter-spacing: 3px;
    font-weight: 500;
    text-transform: uppercase;
  }
  .k13-nav-wordmark strong {
    font-weight: 900;
  }
  .k13-nav-region {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    color: rgba(10, 10, 12, 0.55);
  }
  .k13-nav-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #0A0A0C;
    text-decoration: none;
    transition: opacity 0.2s ease;
    position: relative;
  }
  .k13-nav-action:hover {
    opacity: 0.65;
  }
  .k13-cart-badge {
    position: absolute;
    top: -5px;
    right: -8px;
    background: #0A0A0C;
    color: #FFFFFF;
    font-size: 9px;
    font-weight: 700;
    min-width: 16px;
    height: 16px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    line-height: 1;
  }

  /* Drawer */
  .k13-mobile-drawer {
    position: fixed;
    inset: 0;
    z-index: 1000;
    pointer-events: none;
    visibility: hidden;
    transition: visibility 0.3s ease;
  }
  .k13-mobile-drawer.is-open {
    pointer-events: auto;
    visibility: visible;
  }
  .k13-drawer-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .k13-mobile-drawer.is-open .k13-drawer-backdrop {
    opacity: 1;
  }
  .k13-drawer-inner {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: min(380px, 86vw);
    background: #0A0A0C;
    color: #FFFFFF;
    display: flex;
    flex-direction: column;
    padding: 24px;
    transform: translateX(-100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 2;
  }
  .k13-mobile-drawer.is-open .k13-drawer-inner {
    transform: translateX(0);
  }
  .k13-drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .k13-drawer-tag {
    font-size: 9px;
    letter-spacing: 2px;
    color: rgba(255, 255, 255, 0.5);
    font-weight: 700;
  }
  .k13-drawer-close {
    background: transparent;
    border: none;
    color: #FFFFFF;
    font-size: 18px;
    cursor: pointer;
    padding: 4px;
  }
  .k13-drawer-nav {
    display: flex;
    flex-direction: column;
    padding: 24px 0;
    flex: 1;
  }
  .k13-drawer-link {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
    color: #FFFFFF;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 13px;
    letter-spacing: 1.5px;
    font-weight: 700;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .k13-drawer-link .num {
    font-size: 10px;
    color: #F26B21;
    font-family: monospace;
  }
  .k13-drawer-link .label {
    flex: 1;
  }
  .k13-drawer-link .arrow {
    opacity: 0.4;
  }
  .k13-drawer-link:hover {
    color: #F26B21;
    transform: translateX(4px);
  }
  .k13-drawer-foot {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 10px;
    letter-spacing: 1.5px;
    color: rgba(255, 255, 255, 0.45);
  }
  .k13-drawer-info {
    display: flex;
    justify-content: space-between;
  }
  .k13-drawer-social a {
    color: #FFFFFF;
    text-decoration: none;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .k13-desktop-nav {
      display: none;
    }
    .k13-nav-burger {
      display: flex;
    }
    .k13-nav-region {
      display: none;
    }
    .k13-nav-wrap {
      padding: 0 16px;
      height: 58px;
    }
  }
</style>

<script>
  (function () {
    var toggle = document.getElementById('k13-menu-toggle');
    var drawer = document.getElementById('k13-drawer');
    var close = document.getElementById('k13-drawer-close');
    var backdrop = document.getElementById('k13-drawer-backdrop');

    function openDrawer() {
      if (drawer) {
        drawer.classList.add('is-open');
        drawer.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
    }
    window.closeK13Drawer = function () {
      if (drawer) {
        drawer.classList.remove('is-open');
        drawer.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
    };

    if (toggle) toggle.addEventListener('click', openDrawer);
    if (close) close.addEventListener('click', window.closeK13Drawer);
    if (backdrop) backdrop.addEventListener('click', window.closeK13Drawer);
  })();
</script>

{% schema %}
{
  "name": "K13 Luxury Header",
  "tag": "section",
  "class": "section-k13-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Brand Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 240,
      "step": 10,
      "unit": "px",
      "label": "Logo Width",
      "default": 140
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_header",
      "label": "Enable Sticky Header",
      "default": true
    }
  ]
}
{% endschema %}
