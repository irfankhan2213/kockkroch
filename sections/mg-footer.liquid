{% comment %} KOCKKROCH — Black mega footer (MAFIA language) {% endcomment %}
<footer class="mg-footer">
  <div class="mg-wrap">
    <div class="mg-footer__word">KOCK<span>KROCH</span></div>
    <div class="mg-footer__grid">
      <div>
        <h5>THE BRAND</h5>
        <p>Fearless from origin. Built to survive. Heavyweight streetwear engineered between Tokyo and California — Drop 013.</p>
      </div>
      <div>
        <h5>SHOP</h5>
