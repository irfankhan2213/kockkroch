{% comment %} KOCKKROCH — Bonkers capsules {% endcomment %}
<section class="kx-sec" style="padding-top:56px">
  <div class="kx-wrap">
    <div class="kx-sec-head kx-reveal">
      <div>
        <span class="kx-eyebrow"><span class="dot"></span> {{ section.settings.subtitle | default: 'PICK YOUR POISON' }}</span>
        <h2>{{ section.settings.title_top | default: 'SHOP BY' }} <em>{{ section.settings.title_italic | default: 'obsession' }}</em></h2>
      </div>
      <a class="kx-sec-link" href="{{ section.settings.link | default: '/collections/all' }}">{{ section.settings.link_text | default: 'VIEW EVERYTHING →' }}</a>
    </div>
    <div class="kx-caps">
      <a href="/collections/all" class="kx-cap kx-reveal">
        <div class="kx-cap__media"><span class="kx-cap__num">01</span><img src="{{ 'kockkroch-capsule-hoodies.webp' | asset_url }}" alt="Fleece" loading="lazy"></div>
        <div class="kx-cap__meta"><h3>HEAVY<br>FLEECE</h3><span>450 GSM ✦ 4 PCS</span></div>
      </a>
      <a href="/collections/all" class="kx-cap kx-reveal">
        <div class="kx-cap__media"><span class="kx-cap__num">02</span><img src="{{ 'kockkroch-capsule-tees.webp' | asset_url }}" alt="Tees" loading="lazy"></div>
        <div class="kx-cap__meta"><h3>BOXY<br>TEES</h3><span>280 GSM ✦ 6 PCS</span></div>
      </a>
      <a href="/collections/all" class="kx-cap kx-reveal">
        <div class="kx-cap__media"><span class="kx-cap__num">03</span><img src="{{ 'kockkroch-capsule-cargos.webp' | asset_url }}" alt="Trousers" loading="lazy"></div>
        <div class="kx-cap__meta"><h3>WIDE<br>TROUSERS</h3><span>RIPSTOP ✦ 3 PCS</span></div>
      </a>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "KX Bone Capsules",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "subtitle", "label": "Eyebrow", "default": "PICK YOUR POISON" },
    { "type": "text", "id": "title_top", "label": "Title", "default": "SHOP BY" },
    { "type": "text", "id": "title_italic", "label": "Title italic", "default": "obsession" },
    { "type": "text", "id": "link_text", "label": "Link", "default": "VIEW EVERYTHING →" },
    { "type": "url", "id": "link", "label": "Link URL" }
  ],
  "presets": [{ "name": "KX Bone Capsules" }]
}
{% endschema %}
