{% comment %} KOCK KROCH — Black category strip: 240 GSM / 180 GSM / 210 GSM {% endcomment %}
<section class="k13-cats">
  <div class="k13-cats__grid">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link | default: '/collections/all' }}" class="k13-cat" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
        {% else %}
          <img src="{{ block.settings.fallback | default: 'kockkroch-acid-wash-240gsm-front.png' | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
        {% endif %}
        <div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.sub }}</p>
          <span>{{ block.settings.cta | default: 'EXPLORE' }} →</span>
        </div>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "K13 Category Strip",
  "tag": "section",
  "enabled_on": { "templates": ["*"] },
  "blocks": [
    {
      "type": "cat",
      "name": "Category card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback", "label": "Fallback asset filename", "default": "kockkroch-acid-wash-240gsm-front.png" },
        { "type": "text", "id": "title", "label": "Title", "default": "240 GSM ACID WASH" },
        { "type": "text", "id": "sub", "label": "Subtitle", "default": "Brutalist Skyline & Exoskeleton." },
        { "type": "text", "id": "cta", "label": "Link label", "default": "EXPLORE 240 GSM" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "K13 Category Strip",
      "blocks": [
        { "type": "cat", "settings": { "title": "240 GSM ACID WASH", "sub": "Brutalist Skyline & Exoskeleton.", "cta": "EXPLORE 240 GSM", "fallback": "kockkroch-acid-wash-240gsm-front.png", "link": "/collections/all" } },
        { "type": "cat", "settings": { "title": "180 GSM JET BLACK", "sub": "Gangster Flying Slogan.", "cta": "EXPLORE 180 GSM", "fallback": "kockkroch-kok-f-180gsm-front.png", "link": "/collections/all" } },
        { "type": "cat", "settings": { "title": "210 GSM NUMERICAL", "sub": "Cryptographic Date Coordinate.", "cta": "EXPLORE 210 GSM", "fallback": "kockkroch-side-p-210gsm-front.png", "link": "/collections/all" } }
      ]
    }
  ]
}
{% endschema %}
