{% comment %} KOCK KROCH — Black category strip: Tees / Hoodies / New Drop {% endcomment %}
<section class="k13-cats">
  <div class="k13-cats__grid">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link | default: '/collections/all' }}" class="k13-cat" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
        {% else %}
          <img src="{{ block.settings.fallback | default: 'kockkroch-product-tee.webp' | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
        {% endif %}
        <div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.sub }}</p>
          <span>{{ block.settings.cta }} →</span>
        </div>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "K13 Category Strip",
  "tag": "section",
  "enabled_on": { "templates": ["*"] },
  "blocks": [
    {
      "type": "cat",
      "name": "Category card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback", "label": "Fallback asset filename", "default": "kockkroch-product-tee.webp" },
        { "type": "text", "id": "title", "label": "Title", "default": "TEES" },
        { "type": "text", "id": "sub", "label": "Subtitle", "default": "Graphic-led, boxy fits." },
        { "type": "text", "id": "cta", "label": "Link label", "default": "SHOP TEES" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "K13 Category Strip",
      "blocks": [
        { "type": "cat", "settings": { "title": "TEES", "sub": "Graphic-led, boxy fits.", "cta": "SHOP TEES", "fallback": "kockkroch-product-tee.webp" } },
        { "type": "cat", "settings": { "title": "HOODIES", "sub": "Warmth with weight.", "cta": "SHOP HOODIES", "fallback": "kockkroch-product-hoodie.webp" } },
        { "type": "cat", "settings": { "title": "NEW DROP", "sub": "Latest limited pieces.", "cta": "EXPLORE", "fallback": "kockkroch-editorial-hoodie.webp" } }
      ]
    }
  ]
}
{% endschema %}
