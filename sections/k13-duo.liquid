{% comment %} KOCK KROCH — Duo campaign blocks, fully editable {% endcomment %}
<section class="k13-duo">
  <a href="{{ section.settings.link_a | default: '/collections/all' }}" class="k13-duo__cell">
    {% if section.settings.image_a != blank %}
      <img src="{{ section.settings.image_a | image_url: width: 1400 }}" alt="{{ section.settings.title_a | strip_html | escape }}" loading="lazy">
    {% else %}
      <img src="{{ 'kockkroch-acid-wash-240gsm-back.png' | asset_url }}" alt="{{ section.settings.title_a | strip_html | escape }}" loading="lazy">
    {% endif %}
    <div class="k13-duo__copy">
      <span class="rule" style="background:{{ section.settings.accent_a | default: '#2E9BFF' }}"></span>
      <h3>{{ section.settings.title_a | default: 'STANDING OUT //\n240 GSM ACID WASH' | newline_to_br }}</h3>
      <p>{{ section.settings.copy_a | default: 'Heavyweight 240 GSM combed cotton with mineral acid-wash finish and bio-mechanical cockroach exoskeleton back shield.' }}</p>
      <span class="k13-btn k13-btn--outline-w">{{ section.settings.cta_a | default: 'EXPLORE COLLECTION →' }}</span>
    </div>
  </a>
  <a href="{{ section.settings.link_b | default: '/collections/all' }}" class="k13-duo__cell">
    {% if section.settings.image_b != blank %}
      <img src="{{ section.settings.image_b | image_url: width: 1400 }}" alt="{{ section.settings.title_b | strip_html | escape }}" loading="lazy">
    {% else %}
      <img src="{{ 'kockkroch-kok-f-180gsm-back.png' | asset_url }}" alt="{{ section.settings.title_b | strip_html | escape }}" loading="lazy">
    {% endif %}
    <div class="k13-duo__copy">
      <span class="rule" style="background:{{ section.settings.accent_b | default: '#F26B21' }}"></span>
      <h3>{{ section.settings.title_b | default: 'GANGSTER FLYING //\n180 GSM OVERSIZED' | newline_to_br }}</h3>
      <p>{{ section.settings.copy_b | default: 'Iconic statement piece: \'Everyone Is a Gangster Until The Kockkroch Start Flying.\' with cryptographic Roman date III.XVI.MMXXVI.' }}</p>
      <span class="k13-btn k13-btn--black">{{ section.settings.cta_b | default: 'EXPLORE COLLECTION →' }}</span>
    </div>
  </a>
</section>

{% schema %}
{
  "name": "K13 Duo Campaign",
  "tag": "section",
  "enabled_on": { "templates": ["*"] },
  "settings": [
    { "type": "header", "content": "Left block" },
    { "type": "image_picker", "id": "image_a", "label": "Left image" },
    { "type": "textarea", "id": "title_a", "label": "Left title", "default": "STANDING OUT //\n240 GSM ACID WASH" },
    { "type": "textarea", "id": "copy_a", "label": "Left copy", "default": "Heavyweight 240 GSM combed cotton with mineral acid-wash finish and bio-mechanical cockroach exoskeleton back shield." },
    { "type": "text", "id": "cta_a", "label": "Left button", "default": "EXPLORE COLLECTION →" },
    { "type": "url", "id": "link_a", "label": "Left link" },
    {
      "type": "select",
      "id": "accent_a",
      "label": "Left accent",
      "options": [
        { "value": "#2E9BFF", "label": "Electric blue" },
        { "value": "#F26B21", "label": "Signal orange" },
        { "value": "#E3000F", "label": "Red" }
      ],
      "default": "#2E9BFF"
    },
    { "type": "header", "content": "Right block" },
    { "type": "image_picker", "id": "image_b", "label": "Right image" },
    { "type": "textarea", "id": "title_b", "label": "Right title", "default": "GANGSTER FLYING //\n180 GSM OVERSIZED" },
    { "type": "textarea", "id": "copy_b", "label": "Right copy", "default": "Iconic statement piece: 'Everyone Is a Gangster Until The Kockkroch Start Flying.' with cryptographic Roman date III.XVI.MMXXVI." },
    { "type": "text", "id": "cta_b", "label": "Right button", "default": "EXPLORE COLLECTION →" },
    { "type": "url", "id": "link_b", "label": "Right link" },
    {
      "type": "select",
      "id": "accent_b",
      "label": "Right accent",
      "options": [
        { "value": "#2E9BFF", "label": "Electric blue" },
        { "value": "#F26B21", "label": "Signal orange" },
        { "value": "#E3000F", "label": "Red" }
      ],
      "default": "#F26B21"
    }
  ],
  "presets": [{ "name": "K13 Duo Campaign" }]
}
{% endschema %}
