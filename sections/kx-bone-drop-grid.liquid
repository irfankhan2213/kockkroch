{% comment %} KOCKKROCH — Drop grid ticket cards (Shopify-aware + fallback) {% endcomment %}
<section id="kx-shop" class="kx-sec kx-sec--paper kx-grain" style="position:relative">
  <div class="kx-wrap">
    <div class="kx-sec-head kx-reveal">
      <div>
        <span class="kx-eyebrow"><span class="dot"></span> {{ section.settings.subtitle | default: 'DROP 013 — 13 PIECES ONLY' }}</span>
        <h2>{{ section.settings.title_top | default: 'THE' }} <em>{{ section.settings.title_italic | default: 'hot list' }}</em></h2>
      </div>
      <div style="text-align:right">
        <div class="kx-sticker kx-sticker--red" style="margin-bottom:8px">🔥 78% CLAIMED</div><br>
        <a class="kx-sec-link" href="{{ section.settings.link | default: '/collections/all' }}">{{ section.settings.link_text | default: 'SHOP ALL →' }}</a>
      </div>
    </div>
    <div class="kx-drop-grid">
      {% assign coll = collections[section.settings.collection] %}
      {% if coll != blank and coll.products.size > 0 %}
        {% for product in coll.products limit: section.settings.count | default: 4 %}
          <div class="kx-card kx-reveal">
            <a href="{{ product.url }}" class="kx-card__media">
              <div class="kx-card__badges">
                {% if forloop.first %}<span class="kx-pill kx-pill--red">BEST SELLER</span>{% endif %}
                <span class="kx-pill">{{ product.type | default: 'DROP 013' | truncate: 12 }}</span>
              </div>
              <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" loading="lazy">
              <div class="kx-card__quick">{% for v in product.variants limit: 4 %}<button onclick="location.href='{{ product.url }}?variant={{ v.id }}'">{{ v.title }}</button>{% endfor %}</div>
            </a>
            <div class="kx-card__info">
              <span class="kx-card__cat">{{ product.type | default: 'ARCHIVAL' }}</span>
              <h3 class="kx-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
              <div class="kx-card__row"><span class="kx-card__price">{{ product.price | money }}</span><span style="font-size:11px">★ {{ product.metafields.reviews.rating.value | default: '4.9' }}</span></div>
              <div class="kx-card__stock"><i style="width:72%"></i></div>
              <span class="kx-card__stock-label">Only a few left — no restock</span>
            </div>
          </div>
        {% endfor %}
      {% else %}
        {% assign names = 'ARCHIVAL BOXY HOODIE,SIGNATURE BOXY TEE,PLEATED WIDE TROUSER,POPLIN OVERSHIRT' | split: ',' %}
        {% assign prices = '380,180,320,290' | split: ',' %}
        {% assign cats = '450 GSM FLEECE,280 GSM JERSEY,RIPSTOP TWILL,COMPACT POPLIN' | split: ',' %}
        {% assign imgs = 'kockkroch-editorial-hoodie.webp,kockkroch-editorial-tee.webp,kockkroch-editorial-cargo.webp,kockkroch-editorial-overshirt.webp' | split: ',' %}
        {% for n in names %}
          {% assign i = forloop.index0 %}
          <div class="kx-card kx-reveal">
            <a href="/collections/all" class="kx-card__media">
              <div class="kx-card__badges">
                {% if forloop.first %}<span class="kx-pill kx-pill--red">BEST SELLER</span>{% endif %}
                <span class="kx-pill">{{ cats[i] }}</span>
              </div>
              <img src="{{ imgs[i] | asset_url }}" alt="{{ n }}" loading="lazy">
              <div class="kx-card__quick"><button>S</button><button>M</button><button>L</button><button>XL</button></div>
            </a>
            <div class="kx-card__info">
              <span class="kx-card__cat">{{ cats[i] }}</span>
              <h3 class="kx-card__title"><a href="/collections/all">{{ n }}</a></h3>
              <div class="kx-card__row"><span class="kx-card__price">${{ prices[i] }} USD</span><span style="font-size:11px">★ 4.9 (212)</span></div>
              <div class="kx-card__stock"><i style="width:{% if forloop.first %}82%{% elsif forloop.index == 2 %}64%{% elsif forloop.index == 3 %}48%{% else %}71%{% endif %}"></i></div>
              <span class="kx-card__stock-label">{% if forloop.first %}Almost gone{% else %}Low stock — no restock{% endif %}</span>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
    <p style="font-family:var(--kx-grot);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--kx-muted);margin-top:18px">◉ Model is 6'1" wears size M — boxy fit, size down for regular ◉ Free returns 30 days ◉ Owners Club earns 10% back</p>
  </div>
</section>
{% schema %}
{
  "name": "KX Bone Drop Grid",
  "tag": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Eyebrow",
      "default": "DROP 013 \u2014 13 PIECES ONLY"
    },
    {
      "type": "text",
      "id": "title_top",
      "label": "Title",
      "default": "THE"
    },
    {
      "type": "text",
      "id": "title_italic",
      "label": "Title italic",
      "default": "hot list"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link",
      "default": "SHOP ALL \u2192"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link URL"
    },
    {
      "type": "range",
      "id": "count",
      "label": "Products",
      "min": 4,
      "max": 8,
      "step": 4,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "KX Bone Drop Grid"
    }
  ],
  "enabled_on": {
    "templates": [
      "*"
    ]
  }
}
{% endschema %}
