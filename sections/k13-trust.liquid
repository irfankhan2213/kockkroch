{% comment %} KOCK KROCH — Trust strip, editable blocks {% endcomment %}
<section class="k13-trust">
  <div class="k13-trust__grid">
    {% for block in section.blocks %}
      <div class="k13-trust__cell" {{ block.shopify_attributes }}>
        {% case block.settings.icon %}
          {% when 'exchange' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 12a9 9 0 019-9 9 9 0 018 4.7M21 12a9 9 0 01-9 9 9 9 0 01-8-4.7"/><path d="M21 3v5h-5M3 21v-5h5"/></svg>
          {% when 'fit' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M9 3L3 7l3 3v11h12V10l3-3-6-4a3 3 0 01-6 0z"/></svg>
          {% when 'secure' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="5" y="10" width="14" height="10"/><path d="M8 10V7a4 4 0 018 0v3"/></svg>
          {% else %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M1 7h13v9H1zM14 10h4l4 4v2h-8z"/><circle cx="6" cy="18" r="1.8"/><circle cx="18" cy="18" r="1.8"/></svg>
        {% endcase %}
        <div><h4>{{ block.settings.title }}</h4><p>{{ block.settings.sub }}</p></div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "K13 Trust Strip",
  "tag": "section",
  "enabled_on": { "templates": ["*"] },
  "blocks": [
    {
      "type": "perk",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "dispatch", "label": "Delivery truck" },
            { "value": "exchange", "label": "Exchange arrows" },
            { "value": "fit", "label": "Tee / fit" },
            { "value": "secure", "label": "Lock" }
          ],
          "default": "dispatch"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "FAST DISPATCH" },
        { "type": "text", "id": "sub", "label": "Subtitle", "default": "Ships in 24–48 hrs" }
      ]
    }
  ],
  "presets": [
    {
      "name": "K13 Trust Strip",
      "blocks": [
        { "type": "perk", "settings": { "icon": "dispatch", "title": "FAST DISPATCH", "sub": "Ships in 24–48 hrs" } },
        { "type": "perk", "settings": { "icon": "exchange", "title": "EASY EXCHANGE", "sub": "15-day easy exchange" } },
        { "type": "perk", "settings": { "icon": "fit", "title": "HEAVYWEIGHT FIT", "sub": "180–240 GSM dense cotton" } },
        { "type": "perk", "settings": { "icon": "secure", "title": "SECURE CHECKOUT", "sub": "UPI, cards & COD" } }
      ]
    }
  ]
}
{% endschema %}
