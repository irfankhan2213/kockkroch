{% comment %}
  KOCKKROCH — Minimalist Editorial Campaign Banner
  Inspired by ssstein & 3sixteen
{% endcomment %}

<section class="kk-campaign-banner" data-section-id="{{ section.id }}">
  {% if section.settings.image != blank %}
    <img src="{{ section.settings.image | image_url: width: 2200 }}" alt="{{ section.settings.title | escape }}" class="kk-campaign-banner__img" loading="lazy">
  {% else %}
    <img src="{{ 'kockkroch-brand-atelier.webp' | asset_url }}" alt="Atelier Study" class="kk-campaign-banner__img" loading="lazy">
  {% endif %}
  <div class="kk-campaign-banner__overlay"></div>

  <div class="kk-container" style="width: 100%;">
    <div class="kk-campaign-banner__content">
      <span class="kk-campaign-banner__label">{{ section.settings.label | default: 'ATELIER STUDY // AUTUMN WINTER 2026' }}</span>
      <h2 class="kk-campaign-banner__title">{{ section.settings.title | default: 'FORM FOLLOWS SURVIVAL' }}</h2>
      <a href="{{ section.settings.link | default: '#kk-lookbook-section' }}" class="kk-btn kk-btn--ghost-white">
        {{ section.settings.btn_text | default: 'EXPLORE CAMPAIGN →' }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KOCKKROCH Campaign Banner",
  "tag": "section",
  "class": "section-kockkroch-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Overline Label",
      "default": "ATELIER STUDY // AUTUMN WINTER 2026"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "FORM FOLLOWS SURVIVAL"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "EXPLORE CAMPAIGN \u2192"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ]
}
{% endschema %}
