{% comment %}
  KOCKKROCH — Archival Editorial Lookbook
  Inspired by ssstein & 3sixteen
{% endcomment %}

<section id="kk-lookbook-section" class="kk-editorial-lookbook" data-section-id="{{ section.id }}">
  <div class="kk-container">
    <div class="kk-section-header">
      <div class="kk-section-header__meta">
        <span class="kk-section-header__subtitle">{{ section.settings.subtitle | default: 'EDITORIAL SERIES' }}</span>
        <h2 class="kk-section-header__title">{{ section.settings.title | default: 'ARCHIVAL LOOKBOOK' }}</h2>
      </div>
      <div class="kk-lookbook-tabs" style="display: flex; gap: 8px;">
        <button type="button" id="kk-lb-btn-1" class="kk-btn kk-btn--primary" style="padding: 8px 16px; font-size: 10px;" onclick="switchLook(1)">LOOK 01</button>
        <button type="button" id="kk-lb-btn-2" class="kk-btn kk-btn--outline" style="padding: 8px 16px; font-size: 10px;" onclick="switchLook(2)">LOOK 02</button>
      </div>
    </div>

    <!-- Look 01 Content -->
    <div id="kk-look-panel-1" class="kk-lookbook-row">
      <div class="kk-lookbook-media">
        <img
          src="{{ 'kockkroch-acid-wash-240gsm-back.png' | asset_url }}"
          alt="Look 01 — 'Standing Out' 240 GSM Acid Wash Oversized Tee"
          class="kk-lookbook-img"
          loading="lazy"
        >
      </div>
      <div class="kk-lookbook-details">
        <span class="kk-lookbook-tag">LOOK 01 // 240 GSM HEAVYWEIGHT</span>
        <h3 class="kk-lookbook-heading">'STANDING OUT' ACID WASH EXOSKELETON</h3>
        <p class="kk-lookbook-copy">
          Mineral acid-wash patina engineered on 240 GSM combed cotton. Boxy drop-shoulder silhouette with high-density bio-mechanical cockroach exoskeleton back shield.
        </p>

        <div class="kk-lookbook-breakdown">
          <div class="kk-breakdown-item">
            <span class="kk-breakdown-title">'STANDING OUT' 240 GSM ACID WASH TEE</span>
            <span class="kk-breakdown-price">₹2,499</span>
          </div>
          <div class="kk-breakdown-item">
            <span class="kk-breakdown-title">EXOSKELETON BACK SHIELD PRINT</span>
            <span class="kk-breakdown-price">INCLUDED</span>
          </div>
          <div class="kk-breakdown-item">
            <span class="kk-breakdown-title">REINFORCED 1.25" RIBBED COLLAR</span>
            <span class="kk-breakdown-price">INCLUDED</span>
          </div>
        </div>

        <div>
          <a href="/collections/all" class="kk-btn kk-btn--primary">
            EXPLORE THE LOOK →
          </a>
        </div>
      </div>
    </div>

    <!-- Look 02 Content -->
    <div id="kk-look-panel-2" class="kk-lookbook-row" style="display: none;">
      <div class="kk-lookbook-media">
        <img
          src="{{ 'kockkroch-kok-f-180gsm-back.png' | asset_url }}"
          alt="Look 02 — 'Gangster Flying' 180 GSM Jet Black Oversized Tee"
          class="kk-lookbook-img"
          loading="lazy"
        >
      </div>
      <div class="kk-lookbook-details">
        <span class="kk-lookbook-tag">LOOK 02 // 180 GSM JET BLACK</span>
        <h3 class="kk-lookbook-heading">'GANGSTER FLYING' STATEMENT OVERSIZED</h3>
        <p class="kk-lookbook-copy">
          Matte jet black oversized silhouette featuring the iconic slogan: "Everyone Is a Gangster Until The Kockkroch Start Flying." Backed by Roman cryptographic date III.XVI.MMXXVI.
        </p>

        <div class="kk-lookbook-breakdown">
          <div class="kk-breakdown-item">
            <span class="kk-breakdown-title">'GANGSTER FLYING' 180 GSM OVERSIZED TEE</span>
            <span class="kk-breakdown-price">₹1,899</span>
          </div>
          <div class="kk-breakdown-item">
            <span class="kk-breakdown-title">ROMAN NUMERAL CODE III.XVI.MMXXVI</span>
            <span class="kk-breakdown-price">INCLUDED</span>
          </div>
          <div class="kk-breakdown-item">
            <span class="kk-breakdown-title">DROP-SHOULDER STREET CUT</span>
            <span class="kk-breakdown-price">INCLUDED</span>
          </div>
        </div>

        <div>
          <a href="/collections/all" class="kk-btn kk-btn--primary">
            EXPLORE THE LOOK →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function switchLook(lookNumber) {
    var p1 = document.getElementById('kk-look-panel-1');
    var p2 = document.getElementById('kk-look-panel-2');
    var b1 = document.getElementById('kk-lb-btn-1');
    var b2 = document.getElementById('kk-lb-btn-2');

    if (lookNumber === 1) {
      if (p1) p1.style.display = 'grid';
      if (p2) p2.style.display = 'none';
      if (b1) { b1.className = 'kk-btn kk-btn--primary'; }
      if (b2) { b2.className = 'kk-btn kk-btn--outline'; }
    } else {
      if (p1) p1.style.display = 'none';
      if (p2) p2.style.display = 'grid';
      if (b1) { b1.className = 'kk-btn kk-btn--outline'; }
      if (b2) { b2.className = 'kk-btn kk-btn--primary'; }
    }
  }
</script>

{% schema %}
{
  "name": "KOCKKROCH Lookbook",
  "tag": "section",
  "class": "section-kockkroch-lookbook",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "EDITORIAL SERIES"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "ARCHIVAL LOOKBOOK"
    }
  ]
}
{% endschema %}
