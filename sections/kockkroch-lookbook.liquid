{% comment %}
  KOCKKROCH — Archival Editorial Lookbook
  Inspired by ssstein & 3sixteen
{% endcomment %}

<section id="kk-lookbook-section" class="kk-editorial-lookbook" data-section-id="{{ section.id }}">
  <div class="kk-container">
    <div class="kk-section-header">
      <div class="kk-section-header__meta">
        <span class="kk-section-header__subtitle">{{ section.settings.subtitle | default: 'EDITORIAL SERIES' }}</span>
        <h2 class="kk-section-header__title">{{ section.settings.title | default: 'ARCHIVAL LOOKBOOK' }}</h2>
      </div>
      <div class="kk-lookbook-tabs" style="display: flex; gap: 8px;">
        <button type="button" id="kk-lb-btn-1" class="kk-btn kk-btn--primary" style="padding: 8px 16px; font-size: 10px;" onclick="switchLook(1)">LOOK 01</button>
        <button type="button" id="kk-lb-btn-2" class="kk-btn kk-btn--outline" style="padding: 8px 16px; font-size: 10px;" onclick="switchLook(2)">LOOK 02</button>
      </div>
    </div>

    <!-- Look 01 Content -->
    <div id="kk-look-panel-1" class="kk-lookbook-row">
      <div class="kk-lookbook-media">
        <img
          src="{{ 'kockkroch-lookbook-01.webp' | asset_url }}"
          alt="Look 01 — Archival Heavy Fleece & Trousers"
          class="kk-lookbook-img"
          loading="lazy"
        >
      </div>
      <div class="kk-lookbook-details">
        <span class="kk-lookbook-tag">LOOK 01 // ARCHIVAL PROPORTIONS</span>
        <h3 class="kk-lookbook-heading">STRUCTURAL DRAPE & ARCHITECTURAL VOLUME</h3>
        <p class="kk-lookbook-copy">
          A dialogue between weight and volume. The architectural loopback French terry is cut wide through the body and sleeves to maintain a sculpted boxy silhouette, counterbalanced by relaxed pleated trousers.
        </p>

        <div class="kk-lookbook-breakdown">
          <div class="kk-breakdown-item">
            <span class="kk-breakdown-title">ARCHIVAL BOXY HOODIE</span>
            <span class="kk-breakdown-price">$380 USD</span>
          </div>
          <div class="kk-breakdown-item">
            <span class="kk-breakdown-title">PLEATED WIDE-LEG TROUSER</span>
            <span class="kk-breakdown-price">$320 USD</span>
          </div>
          <div class="kk-breakdown-item">
            <span class="kk-breakdown-title">SIGNATURE CREWNECK BASE</span>
            <span class="kk-breakdown-price">$180 USD</span>
          </div>
        </div>

        <div>
          <a href="/products/hoodie" class="kk-btn kk-btn--primary">
            SHOP LOOK 01
          </a>
        </div>
      </div>
    </div>

    <!-- Look 02 Content -->
    <div id="kk-look-panel-2" class="kk-lookbook-row" style="display: none;">
      <div class="kk-lookbook-media">
        <img
          src="{{ 'kockkroch-lookbook-02.webp' | asset_url }}"
          alt="Look 02 — Tailored Minimalist Drape"
          class="kk-lookbook-img"
          loading="lazy"
        >
      </div>
      <div class="kk-lookbook-details">
        <span class="kk-lookbook-tag">LOOK 02 // TAILORED MINIMALISM</span>
        <h3 class="kk-lookbook-heading">FLUID PROPORTIONS & ARCHIVAL SHIRTING</h3>
        <p class="kk-lookbook-copy">
          Minimalist tailoring built for perennial wear. The crisp Italian cotton poplin overshirt provides an understated, fluid drape paired with deep-pleated charcoal wool trousers. Quiet, effortless authority.
        </p>

        <div class="kk-lookbook-breakdown">
          <div class="kk-breakdown-item">
            <span class="kk-breakdown-title">ARCHIVAL POPLIN OVERSHIRT</span>
            <span class="kk-breakdown-price">$290 USD</span>
          </div>
          <div class="kk-breakdown-item">
            <span class="kk-breakdown-title">SIGNATURE BOXY CREWNECK</span>
            <span class="kk-breakdown-price">$180 USD</span>
          </div>
          <div class="kk-breakdown-item">
            <span class="kk-breakdown-title">PLEATED CHARCOAL TROUSER</span>
            <span class="kk-breakdown-price">$340 USD</span>
          </div>
        </div>

        <div>
          <a href="/products/poplin-overshirt" class="kk-btn kk-btn--primary">
            SHOP LOOK 02
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function switchLook(lookNumber) {
    var p1 = document.getElementById('kk-look-panel-1');
    var p2 = document.getElementById('kk-look-panel-2');
    var b1 = document.getElementById('kk-lb-btn-1');
    var b2 = document.getElementById('kk-lb-btn-2');

    if (lookNumber === 1) {
      if (p1) p1.style.display = 'grid';
      if (p2) p2.style.display = 'none';
      if (b1) { b1.className = 'kk-btn kk-btn--primary'; }
      if (b2) { b2.className = 'kk-btn kk-btn--outline'; }
    } else {
      if (p1) p1.style.display = 'none';
      if (p2) p2.style.display = 'grid';
      if (b1) { b1.className = 'kk-btn kk-btn--outline'; }
      if (b2) { b2.className = 'kk-btn kk-btn--primary'; }
    }
  }
</script>

{% schema %}
{
  "name": "KOCKKROCH Lookbook",
  "tag": "section",
  "class": "section-kockkroch-lookbook",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "EDITORIAL SERIES"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "ARCHIVAL LOOKBOOK"
    }
  ],
  "presets": [
    {
      "name": "KOCKKROCH Lookbook"
    }
  ]
}
{% endschema %}
