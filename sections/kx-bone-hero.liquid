{% comment %} KOCKKROCH — Bone Editorial Bonkers Hero / Drop Ticket {% endcomment %}
<section class="kx-hero kx-grain" style="position:relative">
  <div class="kx-hero__topbar">
    <span>● DROP {{ section.settings.drop_no | default: '013' }} — LIVE NOW</span>
    <span class="hide-mobile">TOKYO × CALIFORNIA — {{ section.settings.season | default: 'AW26' }}</span>
    <span>ADMIT ONE 🎟︎</span>
  </div>
  <div class="kx-hero__grid">
    <div class="kx-hero__left">
      <div class="kx-hero__kicker">
        <span class="kx-sticker">✸ COLLECTION {{ section.settings.drop_no | default: '013' }}</span>
        <span class="kx-sticker kx-sticker--red">FEARLESS FROM ORIGIN</span>
        <span class="kx-sticker kx-sticker--black">BUILT TO SURVIVE</span>
      </div>
      <h1 class="kx-display kx-hero__title">
        {{ section.settings.line1 | default: 'KOCX' }} <span class="shard">✦</span><br>
        <span class="row2">{{ section.settings.line2 | default: 'Kroch world' }}</span>
      </h1>
      <div class="kx-hero__sub">
        <p class="kx-hero__copy">{{ section.settings.copy | default: 'Heavyweight ring-spun jerseys, boxy French terry and pleated trousers. Cut wide, built heavy, priced honestly. Once it sells, it never restocks.' }}</p>
        <div>
          <span class="kx-hero__script">{{ section.settings.script | default: 'Fearless from origin →' }}</span>
          <div style="font-family:var(--kx-grot);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--kx-muted);margin-top:8px">★ ★ ★ ★ ★ 2,400+ survivors dressed</div>
        </div>
      </div>
      <div class="kx-hero__ctas">
        <a href="{{ section.settings.primary_link | default: '/collections/all' }}" class="kx-btn kx-btn--ink">{{ section.settings.primary_text | default: 'SHOP DROP 013 →' }}</a>
        <a href="{{ section.settings.secondary_link | default: '#kx-look' }}" class="kx-btn kx-btn--paper">{{ section.settings.secondary_text | default: 'VIEW LOOKBOOK' }}</a>
      </div>
      <div class="kx-hero__meta">
        <span>450 GSM FLEECE</span><span>•</span><span>280 GSM JERSEY</span><span>•</span><span>ZERO-TORQUE</span>
      </div>
      <div class="kx-hero__013" aria-hidden="true">013</div>
    </div>
    <div class="kx-hero__right">
      <div class="kx-hero__arch">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | image_url: width: 1400 }}" alt="KOCKKROCH campaign" class="kx-hero__img" loading="eager">
        {% else %}
          <img src="{{ 'kockkroch-hero-banner.webp' | asset_url }}" alt="KOCKKROCH campaign" class="kx-hero__img" loading="eager">
        {% endif %}
      </div>
      <div class="kx-hero__emblem-float">
        <img src="{{ 'emblem.svg' | asset_url }}" alt="emblem" style="width:100%;display:block;filter:invert(1)">
      </div>
      <svg class="kx-hero__badge-rotate" viewBox="0 0 100 100">
        <defs><path id="circ-{{ section.id }}" d="M50,50 m-38,0 a38,38 0 1,1 76,0 a38,38 0 1,1 -76,0"/></defs>
        <circle cx="50" cy="50" r="49" fill="#E3000F" stroke="#141310" stroke-width="1.5"/>
        <text style="font-family:Space Grotesk;font-size:11px;font-weight:700;letter-spacing:2.5px;fill:#FAF7EF"><textPath href="#circ-{{ section.id }}">DROP 013 • BUILT TO SURVIVE • </textPath></text>
        <text x="50" y="58" text-anchor="middle" style="font-family:Anton;font-size:22px;fill:#FAF7EF">✦</text>
      </svg>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "KX Bone Hero Ticket",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "drop_no", "label": "Drop number", "default": "013" },
    { "type": "text", "id": "season", "label": "Season", "default": "AW26" },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "line1", "label": "Title line 1", "default": "KOCX" },
    { "type": "text", "id": "line2", "label": "Title line 2 (serif italic)", "default": "Kroch world" },
    { "type": "textarea", "id": "copy", "label": "Copy", "default": "Heavyweight ring-spun jerseys, boxy French terry and pleated trousers. Cut wide, built heavy, priced honestly. Once it sells, it never restocks." },
    { "type": "text", "id": "script", "label": "Handwritten note", "default": "Fearless from origin →" },
    { "type": "text", "id": "primary_text", "label": "Primary CTA", "default": "SHOP DROP 013 →" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_text", "label": "Secondary CTA", "default": "VIEW LOOKBOOK" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" }
  ],
  "presets": [{ "name": "KX Bone Hero Ticket" }]
}
{% endschema %}
