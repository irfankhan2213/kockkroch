{% comment %}
  KOCKKROCH — Atelier Monograph & Brand Philosophy
  Inspired by ssstein & Kallmeyer NYC
{% endcomment %}

<section class="kk-monograph" data-section-id="{{ section.id }}">
  <div class="kk-container">
    <div class="kk-monograph-grid">
      <div class="kk-monograph-media">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}" class="kk-monograph-img" loading="lazy">
        {% else %}
          <img src="{{ 'kockkroch-brand-atelier.webp' | asset_url }}" alt="Tokyo Atelier Workspace" class="kk-monograph-img" loading="lazy">
        {% endif %}
      </div>

      <div class="kk-monograph-content">
        <span class="kk-monograph-label">{{ section.settings.label | default: 'ATELIER MONOGRAPH // 01' }}</span>
        <h2 class="kk-monograph-quote">
          {{ section.settings.heading | default: '“WE ENGINEER SILHOUETTES FOR SURVIVAL IN AN EPHEMERAL WORLD.”' }}
        </h2>
        <p class="kk-monograph-body">
          {{ section.settings.body_text | default: 'Conceived between Tokyo and California, KOCKKROCH was born from an obsession with permanence. Rejecting the disposable cadence of fast trend cycles, we construct unyielding garments using high-density ring-spun cottons, custom Japanese hardware, and balanced boxy proportions engineered for decades of continuous wear. Form follows survival.' }}
        </p>
        <div class="kk-monograph-signoff">
          <span>KOCKKROCH ATELIER — TOKYO • CALIFORNIA</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KOCKKROCH Atelier Monograph",
  "tag": "section",
  "class": "section-kockkroch-manifesto",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Atelier Image"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Overline Label",
      "default": "ATELIER MONOGRAPH // 01"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Quote / Heading",
      "default": "“WE ENGINEER SILHOUETTES FOR SURVIVAL IN AN EPHEMERAL WORLD.”"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body Copy",
      "default": "Conceived between Tokyo and California, KOCKKROCH was born from an obsession with permanence. Rejecting the disposable cadence of fast trend cycles, we construct unyielding garments using high-density ring-spun cottons, custom Japanese hardware, and balanced boxy proportions engineered for decades of continuous wear. Form follows survival."
    }
  ],
  "presets": [
    {
      "name": "KOCKKROCH Atelier Monograph"
    }
  ]
}
{% endschema %}
