{% comment %} KOCK KROCH — THE DROP IN THE WILD (community lookbook), editable {% endcomment %}
<section id="k13-wild" class="k13-sec">
  <div class="k13-wrap">
    <div class="k13-wild__head k13-reveal">
      <span class="k13-eyebrow">{{ section.settings.eyebrow | default: 'COMMUNITY LOOKBOOK' }}</span>
      <h2>{{ section.settings.title | default: 'THE DROP IN THE WILD.' }}</h2>
      <a href="{{ section.settings.handle_link | default: 'https://instagram.com/kockkroch' }}" target="_blank" rel="noopener">{{ section.settings.handle_label | default: '@KOCKKROCH ON INSTAGRAM →' }}</a>
    </div>
    <div class="k13-wild__grid">
      {% for block in section.blocks %}
        <a href="{{ section.settings.handle_link | default: 'https://instagram.com/kockkroch' }}" target="_blank" rel="noopener" class="k13-wild__tile k13-reveal" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 700 }}" alt="{{ block.settings.handle | escape }}" loading="lazy">
          {% else %}
            <img src="{{ block.settings.fallback | default: 'kockkroch-acid-wash-240gsm-back.png' | asset_url }}" alt="Community look" loading="lazy">
          {% endif %}
          <span class="k13-wild__tag">{{ block.settings.handle | default: '@kockkroch' }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "K13 Drop In The Wild",
  "tag": "section",
  "enabled_on": { "templates": ["*"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "COMMUNITY LOOKBOOK" },
    { "type": "text", "id": "title", "label": "Heading", "default": "THE DROP IN THE WILD." },
    { "type": "text", "id": "handle_label", "label": "Handle link label", "default": "@KOCKKROCH ON INSTAGRAM →" },
    { "type": "url", "id": "handle_link", "label": "Handle link" }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Community look",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "fallback", "label": "Fallback asset filename", "default": "kockkroch-acid-wash-240gsm-back.png" },
        { "type": "text", "id": "handle", "label": "Handle tag", "default": "@kockkroch" }
      ]
    }
  ],
  "presets": [
    {
      "name": "K13 Drop In The Wild",
      "blocks": [
        { "type": "look", "settings": { "handle": "@kockkroch • EXOSKELETON", "fallback": "kockkroch-acid-wash-240gsm-back.png" } },
        { "type": "look", "settings": { "handle": "@kockkroch • GANGSTER FLYING", "fallback": "kockkroch-kok-f-180gsm-detail.png" } },
        { "type": "look", "settings": { "handle": "@kockkroch • NUMERICAL CODE", "fallback": "kockkroch-side-p-210gsm-detail.png" } },
        { "type": "look", "settings": { "handle": "@kockkroch • SKYLINE ART", "fallback": "kockkroch-acid-wash-240gsm-detail.png" } }
      ]
    }
  ]
}
{% endschema %}
