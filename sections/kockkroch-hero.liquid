{% comment %}
  KOCKKROCH — Archival Minimal Hero Campaign
  Inspired by ssstein & 3sixteen
{% endcomment %}

<section id="kockkroch-hero-{{ section.id }}" class="kk-hero" data-section-id="{{ section.id }}">
  <div class="kk-hero__media">
    {% if section.settings.image != blank %}
      <img
        src="{{ section.settings.image | image_url: width: 2200 }}"
        alt="{{ section.settings.title | escape }}"
        class="kk-hero__img"
        loading="eager"
      >
    {% else %}
      <img
        src="{{ 'kockkroch-hero-banner.webp' | asset_url }}"
        alt="KOCKKROCH Editorial Campaign"
        class="kk-hero__img"
        loading="eager"
      >
    {% endif %}
    <div class="kk-hero__overlay"></div>
  </div>

  <div class="kk-hero__content">
    <div class="kk-container">
      <div class="kk-hero__meta">
        <span class="kk-hero__badge">{{ section.settings.caption | default: 'COLLECTION 01 // AUTUMN WINTER 2026' }}</span>
        <h1 class="kk-hero__title">{{ section.settings.title | default: 'ARCHIVAL SILHOUETTES' }}</h1>
        <p class="kk-hero__desc">
          {{ section.settings.subtitle | default: 'Meticulous Japanese and American archival tailoring. Heavyweight ring-spun cottons, drop shoulders, and permanent structural integrity.' }}
        </p>
        <div class="kk-hero__actions">
          <a href="{{ section.settings.primary_btn_link | default: '#kk-catalog-section' }}" class="kk-btn kk-btn--white">
            {{ section.settings.primary_btn_text | default: 'EXPLORE COLLECTION' }}
          </a>
          <a href="{{ section.settings.secondary_btn_link | default: '#kk-lookbook-section' }}" class="kk-btn kk-btn--ghost-white">
            {{ section.settings.secondary_btn_text | default: 'VIEW LOOKBOOK' }}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KOCKKROCH Archival Hero",
  "tag": "section",
  "class": "section-kockkroch-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Overline Caption",
      "default": "COLLECTION 01 // AUTUMN WINTER 2026"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "ARCHIVAL SILHOUETTES"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Meticulous Japanese and American archival tailoring. Heavyweight ring-spun cottons, drop shoulders, and permanent structural integrity."
    },
    {
      "type": "text",
      "id": "primary_btn_text",
      "label": "Primary Button Text",
      "default": "EXPLORE COLLECTION"
    },
    {
      "type": "url",
      "id": "primary_btn_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_btn_text",
      "label": "Secondary Button Text",
      "default": "VIEW LOOKBOOK"
    },
    {
      "type": "url",
      "id": "secondary_btn_link",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "KOCKKROCH Archival Hero"
    }
  ]
}
{% endschema %}
