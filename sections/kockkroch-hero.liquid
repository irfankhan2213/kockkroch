{% comment %}
  KOCKKROCH (KOCX KROCH) — Brutalist Rebel Hero Section
  Fearless from Origin • Built to Survive
{% endcomment %}

<section id="kockkroch-hero-{{ section.id }}" class="kk-hero" data-section-id="{{ section.id }}">
  <div class="kk-hero__bg-wrap">
    {% if section.settings.image != blank %}
      <img
        src="{{ section.settings.image | image_url: width: 2000 }}"
        alt="{{ section.settings.title | escape }}"
        class="kk-hero__bg-img"
        loading="eager"
      >
    {% else %}
      <div class="kk-hero__bg-img" style="background: radial-gradient(circle at center, #181822 0%, #08080A 100%);"></div>
    {% endif %}
    <div class="kk-hero__overlay"></div>
  </div>

  <div class="kk-hero__content">
    <div class="kk-hero__meta-top">
      <span class="kk-tag kk-tag--red">{{ section.settings.badge_tag_1 | default: '[SYSTEM OVERRIDE]' }}</span>
      <span class="kk-tag">{{ section.settings.badge_tag_2 | default: 'DROP 013 • ARCHIVE' }}</span>
      <span class="kk-tag">{{ section.settings.badge_tag_3 | default: 'III.XVI.MMXXVI' }}</span>
    </div>

    <h1 class="kk-hero__title">
      {{ section.settings.title_line_1 | default: 'BUILT TO' }}
      <span class="kk-red-text">{{ section.settings.title_highlight | default: 'SURVIVE' }}</span>
    </h1>

    <p class="kk-hero__subtitle">
      {{ section.settings.subtitle | default: 'Fearless from origin. Underground streetwear forged in defiance of standard conformity. Heavyweight cuts engineered for the rebel soul.' }}
    </p>

    <div class="kk-hero__actions">
      {% if section.settings.primary_btn_text != blank %}
        <a href="{{ section.settings.primary_btn_link | default: '/collections/all' }}" class="kk-btn kk-btn-primary">
          <span>{{ section.settings.primary_btn_text }}</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      {% endif %}

      {% if section.settings.secondary_btn_text != blank %}
        <a href="{{ section.settings.secondary_btn_link | default: '/pages/lookbook' }}" class="kk-btn kk-btn-outline">
          <span>{{ section.settings.secondary_btn_text }}</span>
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KOCKKROCH Hero Banner",
  "tag": "section",
  "class": "section-kockkroch-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "badge_tag_1",
      "label": "Badge Tag 1",
      "default": "[SYSTEM OVERRIDE]"
    },
    {
      "type": "text",
      "id": "badge_tag_2",
      "label": "Badge Tag 2",
      "default": "DROP 013 • ARCHIVE"
    },
    {
      "type": "text",
      "id": "badge_tag_3",
      "label": "Badge Tag 3",
      "default": "III.XVI.MMXXVI"
    },
    {
      "type": "text",
      "id": "title_line_1",
      "label": "Title (Main)",
      "default": "BUILT TO"
    },
    {
      "type": "text",
      "id": "title_highlight",
      "label": "Title (Red Highlight)",
      "default": "SURVIVE"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle / Description",
      "default": "Fearless from origin. Underground streetwear forged in defiance of standard conformity. Heavyweight cuts engineered for the rebel soul."
    },
    {
      "type": "text",
      "id": "primary_btn_text",
      "label": "Primary Button Text",
      "default": "EXPLORE DROP 013"
    },
    {
      "type": "url",
      "id": "primary_btn_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_btn_text",
      "label": "Secondary Button Text",
      "default": "VIEW LOOKBOOK"
    },
    {
      "type": "url",
      "id": "secondary_btn_link",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "KOCKKROCH Hero Banner"
    }
  ]
}
{% endschema %}
