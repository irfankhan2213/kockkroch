{% comment %}
  KOCKKROCH (KOCX KROCH) — Clean Luxury Category Matrix
  Fearless from Origin • Built to Survive • California
{% endcomment %}

<section class="kk-section" data-section-id="{{ section.id }}">
  <div class="kk-section-header">
    <div class="kk-section-header__meta">
      <span class="kk-tag kk-tag--red">{{ section.settings.badge | default: 'COLLECTIONS' }}</span>
      <h2 class="kk-section-header__title">
        {{ section.settings.title | default: 'SURVIVAL CAPSULE' }}
      </h2>
    </div>
    {% if section.settings.view_all_link != blank %}
      <a href="{{ section.settings.view_all_link }}" class="kk-section-header__link">
        <span>VIEW ALL CATEGORIES →</span>
      </a>
    {% endif %}
  </div>

  <div class="kk-collections-grid">
    {% for block in section.blocks %}
      {% assign collection = collections[block.settings.collection] %}
      <a
        href="{% if collection != blank %}{{ collection.url }}{% else %}{{ block.settings.custom_link | default: '/collections/all' }}{% endif %}"
        class="kk-collection-card"
        {{ block.shopify_attributes }}
      >
        <div class="kk-collection-card__media">
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: 800 }}"
              alt="{{ block.settings.title | escape }}"
              class="kk-collection-card__img"
              loading="lazy"
            >
          {% elsif collection.image != blank %}
            <img
              src="{{ collection.image | image_url: width: 800 }}"
              alt="{{ collection.title | escape }}"
              class="kk-collection-card__img"
              loading="lazy"
            >
          {% else %}
            <div class="kk-collection-card__img" style="background: radial-gradient(circle at center, #FFFFFF 0%, #EBEBF0 100%); display: flex; align-items: center; justify-content: center;">
              <svg width="60" height="75" viewBox="0 0 63.80 78.70" opacity="0.85"><path d="M 41.53 22.11 L 36.08 13.65 L 31.23 10.26 L 27.25 13.52 L 22.24 22.35 L 41.53 22.11" fill="none" stroke="#0A0A0C" stroke-width="0.8"/><path d="M 19.29 42.31 L 22.15 23.82 L 41.75 23.59 L 45.28 42.16 L 45.39 50.43 L 36.21 30.32 L 26.88 49.74 L 41.50 63.08 L 39.25 69.79 L 33.73 74.57 L 26.82 69.97 L 22.36 61.04 L 19.29 42.31" fill="none" stroke="#0A0A0C" stroke-width="0.8"/><path d="M 32.00 48.96 L 51.95 69.96 L 38.88 51.18 L 36.14 37.94 L 32.00 48.96 Z" fill="#E3000F" stroke="#E3000F" stroke-width="0.5"/></svg>
            </div>
          {% endif %}
          <div class="kk-collection-card__overlay"></div>
        </div>

        <div class="kk-collection-card__content">
          <span class="kk-collection-card__tag">{{ block.settings.tag | default: 'DROP 013' }}</span>
          <h3 class="kk-collection-card__title">
            {% if block.settings.title != blank %}
              {{ block.settings.title }}
            {% elsif collection != blank %}
              {{ collection.title }}
            {% else %}
              OVERSIZED TEES
            {% endif %}
          </h3>
          <span class="kk-collection-card__count">
            {% if collection != blank %}
              {{ collection.all_products_count }} PRODUCTS
            {% else %}
              EXPLORE CAPSULE →
            {% endif %}
          </span>
        </div>
      </a>
    {% else %}
      <!-- Default Clean Grid -->
      <a href="/collections/all" class="kk-collection-card">
        <div class="kk-collection-card__media">
          <div class="kk-collection-card__img" style="background: radial-gradient(circle at center, #FFFFFF 0%, #EBEBF0 100%); display: flex; align-items: center; justify-content: center;">
            <svg width="60" height="75" viewBox="0 0 63.80 78.70" opacity="0.85"><path d="M 41.53 22.11 L 36.08 13.65 L 31.23 10.26 L 27.25 13.52 L 22.24 22.35 L 41.53 22.11" fill="none" stroke="#0A0A0C" stroke-width="0.8"/><path d="M 19.29 42.31 L 22.15 23.82 L 41.75 23.59 L 45.28 42.16 L 45.39 50.43 L 36.21 30.32 L 26.88 49.74 L 41.50 63.08 L 39.25 69.79 L 33.73 74.57 L 26.82 69.97 L 22.36 61.04 L 19.29 42.31" fill="none" stroke="#0A0A0C" stroke-width="0.8"/><path d="M 32.00 48.96 L 51.95 69.96 L 38.88 51.18 L 36.14 37.94 L 32.00 48.96 Z" fill="#E3000F" stroke="#E3000F" stroke-width="0.5"/></svg>
          </div>
          <div class="kk-collection-card__overlay"></div>
        </div>
        <div class="kk-collection-card__content">
          <span class="kk-collection-card__tag">HEAVYWEIGHT</span>
          <h3 class="kk-collection-card__title">OVERSIZED TEES</h3>
          <span class="kk-collection-card__count">EXPLORE CAPSULE →</span>
        </div>
      </a>
      <a href="/collections/all" class="kk-collection-card">
        <div class="kk-collection-card__media">
          <div class="kk-collection-card__img" style="background: radial-gradient(circle at center, #FFFFFF 0%, #EBEBF0 100%); display: flex; align-items: center; justify-content: center;">
            <svg width="60" height="75" viewBox="0 0 63.80 78.70" opacity="0.85"><path d="M 41.53 22.11 L 36.08 13.65 L 31.23 10.26 L 27.25 13.52 L 22.24 22.35 L 41.53 22.11" fill="none" stroke="#0A0A0C" stroke-width="0.8"/><path d="M 19.29 42.31 L 22.15 23.82 L 41.75 23.59 L 45.28 42.16 L 45.39 50.43 L 36.21 30.32 L 26.88 49.74 L 41.50 63.08 L 39.25 69.79 L 33.73 74.57 L 26.82 69.97 L 22.36 61.04 L 19.29 42.31" fill="none" stroke="#0A0A0C" stroke-width="0.8"/><path d="M 32.00 48.96 L 51.95 69.96 L 38.88 51.18 L 36.14 37.94 L 32.00 48.96 Z" fill="#E3000F" stroke="#E3000F" stroke-width="0.5"/></svg>
          </div>
          <div class="kk-collection-card__overlay"></div>
        </div>
        <div class="kk-collection-card__content">
          <span class="kk-collection-card__tag">FLEECE</span>
          <h3 class="kk-collection-card__title">HOODIES & SWEATS</h3>
          <span class="kk-collection-card__count">EXPLORE CAPSULE →</span>
        </div>
      </a>
      <a href="/collections/all" class="kk-collection-card">
        <div class="kk-collection-card__media">
          <div class="kk-collection-card__img" style="background: radial-gradient(circle at center, #FFFFFF 0%, #EBEBF0 100%); display: flex; align-items: center; justify-content: center;">
            <svg width="60" height="75" viewBox="0 0 63.80 78.70" opacity="0.85"><path d="M 41.53 22.11 L 36.08 13.65 L 31.23 10.26 L 27.25 13.52 L 22.24 22.35 L 41.53 22.11" fill="none" stroke="#0A0A0C" stroke-width="0.8"/><path d="M 19.29 42.31 L 22.15 23.82 L 41.75 23.59 L 45.28 42.16 L 45.39 50.43 L 36.21 30.32 L 26.88 49.74 L 41.50 63.08 L 39.25 69.79 L 33.73 74.57 L 26.82 69.97 L 22.36 61.04 L 19.29 42.31" fill="none" stroke="#0A0A0C" stroke-width="0.8"/><path d="M 32.00 48.96 L 51.95 69.96 L 38.88 51.18 L 36.14 37.94 L 32.00 48.96 Z" fill="#E3000F" stroke="#E3000F" stroke-width="0.5"/></svg>
          </div>
          <div class="kk-collection-card__overlay"></div>
        </div>
        <div class="kk-collection-card__content">
          <span class="kk-collection-card__tag">TACTICAL</span>
          <h3 class="kk-collection-card__title">CARGOS & PANTS</h3>
          <span class="kk-collection-card__count">EXPLORE CAPSULE →</span>
        </div>
      </a>
      <a href="/collections/all" class="kk-collection-card">
        <div class="kk-collection-card__media">
          <div class="kk-collection-card__img" style="background: radial-gradient(circle at center, #FFFFFF 0%, #EBEBF0 100%); display: flex; align-items: center; justify-content: center;">
            <svg width="60" height="75" viewBox="0 0 63.80 78.70" opacity="0.85"><path d="M 41.53 22.11 L 36.08 13.65 L 31.23 10.26 L 27.25 13.52 L 22.24 22.35 L 41.53 22.11" fill="none" stroke="#0A0A0C" stroke-width="0.8"/><path d="M 19.29 42.31 L 22.15 23.82 L 41.75 23.59 L 45.28 42.16 L 45.39 50.43 L 36.21 30.32 L 26.88 49.74 L 41.50 63.08 L 39.25 69.79 L 33.73 74.57 L 26.82 69.97 L 22.36 61.04 L 19.29 42.31" fill="none" stroke="#0A0A0C" stroke-width="0.8"/><path d="M 32.00 48.96 L 51.95 69.96 L 38.88 51.18 L 36.14 37.94 L 32.00 48.96 Z" fill="#E3000F" stroke="#E3000F" stroke-width="0.5"/></svg>
          </div>
          <div class="kk-collection-card__overlay"></div>
        </div>
        <div class="kk-collection-card__content">
          <span class="kk-collection-card__tag">LIMITED</span>
          <h3 class="kk-collection-card__title">ACCESSORIES & GEAR</h3>
          <span class="kk-collection-card__count">EXPLORE CAPSULE →</span>
        </div>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "KOCKKROCH Categories",
  "tag": "section",
  "class": "section-kockkroch-collections",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Section Tag/Badge",
      "default": "COLLECTIONS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "SURVIVAL CAPSULE"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Category Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Shopify Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Card Image (Optional)"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Card Tag",
          "default": "HEAVYWEIGHT"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Category Title (Optional)"
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Custom URL (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KOCKKROCH Categories",
      "blocks": [
        { "type": "collection_card", "settings": { "tag": "HEAVYWEIGHT", "title": "OVERSIZED TEES" } },
        { "type": "collection_card", "settings": { "tag": "FLEECE", "title": "HOODIES & SWEATS" } },
        { "type": "collection_card", "settings": { "tag": "TACTICAL", "title": "CARGOS & PANTS" } },
        { "type": "collection_card", "settings": { "tag": "LIMITED", "title": "ACCESSORIES & GEAR" } }
      ]
    }
  ]
}
{% endschema %}
