{% comment %}
  KOCKKROCH (KOCX KROCH) — Streetwear Collection Matrix
  Fearless from Origin • Built to Survive
{% endcomment %}

<section class="kk-section" data-section-id="{{ section.id }}">
  <div class="kk-section-header">
    <div>
      <span class="kk-tag kk-tag--red">{{ section.settings.badge | default: 'CATEGORIES' }}</span>
      <h2 class="kk-section-header__title" style="margin-top: 8px;">
        {{ section.settings.title | default: 'SURVIVAL CAPSULE' }}
      </h2>
    </div>
    {% if section.settings.view_all_link != blank %}
      <a href="{{ section.settings.view_all_link }}" class="kk-btn kk-btn-outline" style="padding: 10px 20px; font-size: 11px;">
        <span>VIEW ALL CATEGORIES</span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    {% endif %}
  </div>

  <div class="kk-collection-grid">
    {% for block in section.blocks %}
      {% assign collection = collections[block.settings.collection] %}
      <a
        href="{% if collection != blank %}{{ collection.url }}{% else %}{{ block.settings.custom_link | default: '#' }}{% endif %}"
        class="kk-collection-card"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.image != blank %}
          <img
            src="{{ block.settings.image | image_url: width: 800 }}"
            alt="{{ block.settings.title | escape }}"
            class="kk-collection-card__img"
            loading="lazy"
          >
        {% elsif collection.image != blank %}
          <img
            src="{{ collection.image | image_url: width: 800 }}"
            alt="{{ collection.title | escape }}"
            class="kk-collection-card__img"
            loading="lazy"
          >
        {% else %}
          <div class="kk-collection-card__img" style="background: radial-gradient(circle at center, #1E1E26 0%, #0F0F14 100%);"></div>
        {% endif %}

        <div class="kk-collection-card__overlay"></div>

        <div class="kk-collection-card__content">
          <span class="kk-tag" style="margin-bottom: 8px; font-size: 10px;">{{ block.settings.tag | default: '[ARCHIVE]' }}</span>
          <h3 class="kk-collection-card__name">
            {% if block.settings.title != blank %}
              {{ block.settings.title }}
            {% elsif collection != blank %}
              {{ collection.title }}
            {% else %}
              OVERSIZED TEES
            {% endif %}
          </h3>
          <span class="kk-collection-card__count">
            {% if collection != blank %}
              {{ collection.all_products_count }} ITEMS
            {% else %}
              DROP 013
            {% endif %}
          </span>
        </div>
      </a>
    {% else %}
      <!-- Default Placeholder Grid -->
      <div class="kk-collection-card">
        <div class="kk-collection-card__img" style="background: radial-gradient(circle at center, #1c1c24 0%, #0a0a0e 100%);"></div>
        <div class="kk-collection-card__overlay"></div>
        <div class="kk-collection-card__content">
          <span class="kk-tag" style="margin-bottom: 8px; font-size: 10px;">[HEAVYWEIGHT]</span>
          <h3 class="kk-collection-card__name">OVERSIZED TEES</h3>
          <span class="kk-collection-card__count">280 GSM • DROP 013</span>
        </div>
      </div>
      <div class="kk-collection-card">
        <div class="kk-collection-card__img" style="background: radial-gradient(circle at center, #241a1a 0%, #0a0a0e 100%);"></div>
        <div class="kk-collection-card__overlay"></div>
        <div class="kk-collection-card__content">
          <span class="kk-tag" style="margin-bottom: 8px; font-size: 10px;">[FLEECE]</span>
          <h3 class="kk-collection-card__name">HOODIES & SWEATS</h3>
          <span class="kk-collection-card__count">450 GSM • SURVIVAL FIT</span>
        </div>
      </div>
      <div class="kk-collection-card">
        <div class="kk-collection-card__img" style="background: radial-gradient(circle at center, #1a2024 0%, #0a0a0e 100%);"></div>
        <div class="kk-collection-card__overlay"></div>
        <div class="kk-collection-card__content">
          <span class="kk-tag" style="margin-bottom: 8px; font-size: 10px;">[TACTICAL]</span>
          <h3 class="kk-collection-card__name">CARGOS & PANTS</h3>
          <span class="kk-collection-card__count">ACID WASH • MULTI-POCKET</span>
        </div>
      </div>
      <div class="kk-collection-card">
        <div class="kk-collection-card__img" style="background: radial-gradient(circle at center, #241c1a 0%, #0a0a0e 100%);"></div>
        <div class="kk-collection-card__overlay"></div>
        <div class="kk-collection-card__content">
          <span class="kk-tag" style="margin-bottom: 8px; font-size: 10px;">[LIMITED]</span>
          <h3 class="kk-collection-card__name">ACCESSORIES & GEAR</h3>
          <span class="kk-collection-card__count">HARDWARE • SURVIVAL</span>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "KOCKKROCH Categories",
  "tag": "section",
  "class": "section-kockkroch-collections",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Section Tag/Badge",
      "default": "CATEGORIES"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "SURVIVAL CAPSULE"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Category Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Shopify Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Card Image (Optional)"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Card Tag/Subheading",
          "default": "[DROP 013]"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Category Title (Optional)"
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Custom URL (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KOCKKROCH Categories",
      "blocks": [
        { "type": "collection_card", "settings": { "tag": "[HEAVYWEIGHT]", "title": "OVERSIZED TEES" } },
        { "type": "collection_card", "settings": { "tag": "[FLEECE]", "title": "HOODIES & SWEATS" } },
        { "type": "collection_card", "settings": { "tag": "[TACTICAL]", "title": "CARGOS & PANTS" } },
        { "type": "collection_card", "settings": { "tag": "[LIMITED]", "title": "ACCESSORIES & GEAR" } }
      ]
    }
  ]
}
{% endschema %}
