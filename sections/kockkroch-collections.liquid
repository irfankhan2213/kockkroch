{% comment %}
  KOCKKROCH — Minimalist Capsule Silhouettes
  Inspired by ssstein & 3sixteen
{% endcomment %}

<section class="kk-capsules" data-section-id="{{ section.id }}">
  <div class="kk-container">
    <div class="kk-section-header">
      <div class="kk-section-header__meta">
        <span class="kk-section-header__subtitle">{{ section.settings.subtitle | default: 'CURATED SILHOUETTES' }}</span>
        <h2 class="kk-section-header__title">{{ section.settings.title | default: 'CAPSULE RELEASES' }}</h2>
      </div>
      <a href="{{ section.settings.view_all_link | default: '/collections/all' }}" class="kk-section-header__link">
        {{ section.settings.link_text | default: 'VIEW ALL SILHOUETTES →' }}
      </a>
    </div>

    <div class="kk-capsules-grid">
      {% for block in section.blocks %}
        {% assign collection = collections[block.settings.collection] %}
        <a href="{% if collection != blank %}{{ collection.url }}{% else %}{{ block.settings.custom_link | default: '/collections/all' }}{% endif %}" class="kk-capsule-item" {{ block.shopify_attributes }}>
          <div class="kk-capsule-item__media">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.title | escape }}" class="kk-capsule-item__img" loading="lazy">
            {% elsif collection.image != blank %}
              <img src="{{ collection.image | image_url: width: 900 }}" alt="{{ collection.title | escape }}" class="kk-capsule-item__img" loading="lazy">
            {% else %}
              <img src="{{ 'kockkroch-capsule-tees.webp' | asset_url }}" alt="Capsule Silhouette" class="kk-capsule-item__img" loading="lazy">
            {% endif %}
          </div>
          <div class="kk-capsule-item__meta">
            <h3 class="kk-capsule-item__title">
              {% if block.settings.title != blank %}{{ block.settings.title }}{% elsif collection != blank %}{{ collection.title }}{% else %}CAPSULE SILHOUETTE{% endif %}
            </h3>
            <span class="kk-capsule-item__count">
              {% if block.settings.subtitle != blank %}{{ block.settings.subtitle }}{% else %}EXPLORE{% endif %}
            </span>
          </div>
        </a>
      {% else %}
        <!-- Default Clean 3-Column Grid -->
        <a href="/collections/all" class="kk-capsule-item">
          <div class="kk-capsule-item__media">
            <img src="{{ 'kockkroch-capsule-hoodies.webp' | asset_url }}" alt="Heavyweight Fleece & Outerwear" class="kk-capsule-item__img" loading="lazy">
          </div>
          <div class="kk-capsule-item__meta">
            <h3 class="kk-capsule-item__title">HEAVYWEIGHT FLEECE</h3>
            <span class="kk-capsule-item__count">06 PIECES</span>
          </div>
        </a>
        <a href="/collections/all" class="kk-capsule-item">
          <div class="kk-capsule-item__media">
            <img src="{{ 'kockkroch-capsule-tees.webp' | asset_url }}" alt="Zero-Torque Heavyweight Tees" class="kk-capsule-item__img" loading="lazy">
          </div>
          <div class="kk-capsule-item__meta">
            <h3 class="kk-capsule-item__title">ZERO-TORQUE TEES</h3>
            <span class="kk-capsule-item__count">08 PIECES</span>
          </div>
        </a>
        <a href="/collections/all" class="kk-capsule-item">
          <div class="kk-capsule-item__media">
            <img src="{{ 'kockkroch-capsule-cargos.webp' | asset_url }}" alt="Tactical & Tailored Trousers" class="kk-capsule-item__img" loading="lazy">
          </div>
          <div class="kk-capsule-item__meta">
            <h3 class="kk-capsule-item__title">TAILORED TROUSERS</h3>
            <span class="kk-capsule-item__count">04 PIECES</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KOCKKROCH Capsules",
  "tag": "section",
  "class": "section-kockkroch-capsules",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "CURATED SILHOUETTES"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "CAPSULE RELEASES"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "VIEW ALL SILHOUETTES →"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    }
  ],
  "blocks": [
    {
      "type": "capsule_item",
      "name": "Capsule Item",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Shopify Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Pieces / Subtitle",
          "default": "EXPLORE"
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Custom URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KOCKKROCH Capsules",
      "blocks": [
        { "type": "capsule_item", "settings": { "title": "HEAVYWEIGHT FLEECE", "subtitle": "06 PIECES" } },
        { "type": "capsule_item", "settings": { "title": "ZERO-TORQUE TEES", "subtitle": "08 PIECES" } },
        { "type": "capsule_item", "settings": { "title": "TAILORED TROUSERS", "subtitle": "04 PIECES" } }
      ]
    }
  ]
}
{% endschema %}
