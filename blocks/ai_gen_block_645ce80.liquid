{% doc %}
  @prompt
    Create an announcement bar with text that scrolls smoothly and continuously from right to left in a seamless loop. Match my existing theme’s colors, font, and bar height. Let me edit the announcement text, link, scrolling speed, text color, and background color. Make it work on desktop and mobile, pause on hover, and respect reduced-motion preferences., make possible to add multiple text, remove stars
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
  }

  .ai-announcement-{{ ai_gen_id }} .ai-announcement__viewport-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    min-height: {{ block.settings.bar_height }}px;
    overflow: hidden;
  }

  .ai-announcement-{{ ai_gen_id }} .ai-announcement__track-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    width: max-content;
    animation: ai-announcement-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
    will-change: transform;
  }

  .ai-announcement-{{ ai_gen_id }}:hover .ai-announcement__track-{{ ai_gen_id }} {
    animation-play-state: paused;
  }

  .ai-announcement-{{ ai_gen_id }} .ai-announcement__group-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
  }

  .ai-announcement-{{ ai_gen_id }} .ai-announcement__item-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    padding-inline: 2rem;
    color: inherit;
    font-size: 13px;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }

  .ai-announcement-{{ ai_gen_id }} a.ai-announcement__item-{{ ai_gen_id }}:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @keyframes ai-announcement-scroll-{{ ai_gen_id }} {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (max-width: 749px) {
    .ai-announcement-{{ ai_gen_id }} { width: 100%; }
    .ai-announcement-{{ ai_gen_id }} .ai-announcement__item-{{ ai_gen_id }} {
      padding-inline: 1.25rem;
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-announcement-{{ ai_gen_id }} .ai-announcement__viewport-{{ ai_gen_id }} {
      overflow-x: auto;
      scrollbar-width: none;
    }
    .ai-announcement-{{ ai_gen_id }} .ai-announcement__viewport-{{ ai_gen_id }}::-webkit-scrollbar { display: none; }
    .ai-announcement-{{ ai_gen_id }} .ai-announcement__track-{{ ai_gen_id }} {
      animation: none;
      width: 100%;
      justify-content: center;
    }
    .ai-announcement-{{ ai_gen_id }} .ai-announcement__group-{{ ai_gen_id }}:last-child { display: none; }
    .ai-announcement-{{ ai_gen_id }} .ai-announcement__item-{{ ai_gen_id }} {
      white-space: normal;
      text-align: center;
    }
  }
{% endstyle %}

<div class="ai-announcement-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-announcement__viewport-{{ ai_gen_id }}" aria-label="Announcements">
    <div class="ai-announcement__track-{{ ai_gen_id }}">
      {% for copy in (1..2) %}
        <div class="ai-announcement__group-{{ ai_gen_id }}" {% if copy == 2 %}aria-hidden="true"{% endif %}>
          {% if block.settings.announcement_text != blank %}
            {% if block.settings.announcement_link != blank %}<a class="ai-announcement__item-{{ ai_gen_id }}" href="{{ block.settings.announcement_link }}" {% if copy == 2 %}tabindex="-1"{% endif %}>{{ block.settings.announcement_text | escape }}</a>{% else %}<span class="ai-announcement__item-{{ ai_gen_id }}">{{ block.settings.announcement_text | escape }}</span>{% endif %}
          {% endif %}
          {% if block.settings.announcement_text_2 != blank %}
            {% if block.settings.announcement_link != blank %}<a class="ai-announcement__item-{{ ai_gen_id }}" href="{{ block.settings.announcement_link }}" {% if copy == 2 %}tabindex="-1"{% endif %}>{{ block.settings.announcement_text_2 | escape }}</a>{% else %}<span class="ai-announcement__item-{{ ai_gen_id }}">{{ block.settings.announcement_text_2 | escape }}</span>{% endif %}
          {% endif %}
          {% if block.settings.announcement_text_3 != blank %}
            {% if block.settings.announcement_link != blank %}<a class="ai-announcement__item-{{ ai_gen_id }}" href="{{ block.settings.announcement_link }}" {% if copy == 2 %}tabindex="-1"{% endif %}>{{ block.settings.announcement_text_3 | escape }}</a>{% else %}<span class="ai-announcement__item-{{ ai_gen_id }}">{{ block.settings.announcement_text_3 | escape }}</span>{% endif %}
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Scrolling announcement",
  "settings": [
    { "type": "text", "id": "announcement_text", "label": "Announcement 1", "default": "Fearless from origin • built to survive" },
    { "type": "text", "id": "announcement_text_2", "label": "Announcement 2", "default": "Explore the latest collection" },
    { "type": "text", "id": "announcement_text_3", "label": "Announcement 3", "default": "Designed for the fearless" },
    { "type": "url", "id": "announcement_link", "label": "Announcement link" },
    { "type": "range", "id": "scroll_speed", "label": "Loop duration", "min": 10, "max": 80, "step": 5, "unit": "s", "default": 30 },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#F4F2ED" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#101012" },
    { "type": "range", "id": "bar_height", "label": "Bar height", "min": 30, "max": 80, "step": 5, "unit": "px", "default": 40 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Scrolling announcement" }],
  "tag": null,
  "class": "scrolling-announcement-block"
}
{% endschema %}