{% doc %}
  @prompt
    Create an announcement bar with text that scrolls smoothly and continuously from right to left in a seamless loop. Match my existing theme’s colors, font, and bar height. Let me edit the announcement text, link, scrolling speed, text color, and background color. Make it work on desktop and mobile, pause on hover, and respect reduced-motion preferences.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-marquee-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-size: 14px;
    line-height: 1.2;
  }
  .ai-marquee-{{ ai_gen_id }} .ai-marquee__viewport {
    overflow: hidden;
    width: 100%;
    padding: 12px 0;
  }
  .ai-marquee-{{ ai_gen_id }} .ai-marquee__track {
    display: flex;
    width: max-content;
    white-space: nowrap;
    animation: ai-marquee-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
  }
  .ai-marquee-{{ ai_gen_id }}:hover .ai-marquee__track,
  .ai-marquee-{{ ai_gen_id }}:focus-within .ai-marquee__track {
    animation-play-state: paused;
  }
  .ai-marquee-{{ ai_gen_id }} .ai-marquee__item {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    padding-right: 3rem;
    color: inherit;
    text-decoration: none;
  }
  .ai-marquee-{{ ai_gen_id }} a.ai-marquee__item:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -3px;
  }
  @keyframes ai-marquee-scroll-{{ ai_gen_id }} {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ai-marquee-{{ ai_gen_id }} .ai-marquee__track {
      animation: none;
      width: 100%;
      justify-content: center;
      white-space: normal;
    }
    .ai-marquee-{{ ai_gen_id }} .ai-marquee__item:nth-child(2) { display: none; }
    .ai-marquee-{{ ai_gen_id }} .ai-marquee__item { padding: 0 16px; text-align: center; }
  }
{% endstyle %}

<div class="ai-marquee-{{ ai_gen_id }}" style="width: {{ block.settings.desktop_width_percent }}%;" {{ block.shopify_attributes }}>
  <div class="ai-marquee__viewport">
    <div class="ai-marquee__track">
      {% for i in (1..2) %}
        {% if block.settings.announcement_link != blank %}
          <a class="ai-marquee__item" href="{{ block.settings.announcement_link }}" {% if i == 2 %}aria-hidden="true" tabindex="-1"{% endif %}>{{ block.settings.announcement_text | escape }}</a>
        {% else %}
          <span class="ai-marquee__item" {% if i == 2 %}aria-hidden="true"{% endif %}>{{ block.settings.announcement_text | escape }}</span>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Scrolling announcement",
  "settings": [
    { "type": "text", "id": "announcement_text", "label": "Announcement text", "default": "FEARLESS FROM ORIGIN • BUILT TO SURVIVE" },
    { "type": "url", "id": "announcement_link", "label": "Announcement link" },
    { "type": "range", "id": "scroll_speed", "label": "Loop duration", "min": 8, "max": 80, "step": 4, "unit": "s", "default": 24 },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#F4F2ED" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#101012" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Scrolling announcement" }],
  "tag": null,
  "class": "scrolling-announcement-block"
}
{% endschema %}